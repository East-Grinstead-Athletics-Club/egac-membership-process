---
// src/layouts/Base.astro
// Base layout for all public-facing pages.

interface Props {
  title: string;
  description?: string;
}

import '../styles/tailwind.css';

const { title, description = 'East Grinstead Athletics Club' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — EGAC</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-background text-on-surface font-body antialiased">
    <header class="bg-white/90 backdrop-blur-xl border-b border-outline-variant">
      <div class="max-w-2xl mx-auto px-4 py-4 flex items-center gap-3">
        <a
          href="/"
          class="font-headline font-black tracking-tighter text-primary text-lg hover:text-primary-container transition-colors"
        >
          EGAC
        </a>
        <span class="text-outline-variant">|</span>
        <span class="text-on-surface-variant text-sm">East Grinstead Athletics Club</span>
      </div>
    </header>

    <main class="max-w-2xl mx-auto px-4 py-10">
      <slot />
    </main>

    <footer
      class="mt-16 border-t border-outline-variant py-6 text-center text-xs text-on-surface-variant"
    >
      &copy; {new Date().getFullYear()} East Grinstead Athletics Club
    </footer>
  </body>
</html>
