---
// src/layouts/AdminBase.astro
// Base layout for all admin pages.

interface Props {
  title: string;
  activeNav?: 'enquiries' | 'bookings' | 'reports' | 'templates' | 'config';
}

const { title, activeNav } = Astro.props;

const navItems: Array<{ id: NonNullable<Props['activeNav']>; label: string; href: string }> = [
  { id: 'enquiries', label: 'Enquiries', href: '/admin/enquiries' },
  { id: 'bookings', label: 'Bookings', href: '/admin/bookings' },
  { id: 'reports', label: 'Reports', href: '/admin/reports' },
  { id: 'templates', label: 'Templates', href: '/admin/templates' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — EGAC Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900 antialiased">
    <div class="relative min-h-screen lg:flex">
      <aside class="w-full border-b border-slate-200 bg-slate-900 text-slate-100 lg:sticky lg:top-0 lg:h-screen lg:w-72 lg:border-b-0 lg:border-r lg:border-slate-800">
        <div class="px-6 py-6 border-b border-slate-800">
          <a href="/admin/enquiries" class="text-xl font-bold tracking-tight text-white hover:text-slate-200">
            EGAC Admin
          </a>
          <p class="mt-1 text-xs uppercase tracking-wider text-slate-400">East Grinstead Athletics Club</p>
        </div>

        <nav class="px-3 py-4" aria-label="Admin navigation">
          <ul class="space-y-1">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class={`flex items-center rounded-lg px-3 py-2.5 text-sm font-medium transition-colors ${
                      activeNav === item.id
                        ? 'bg-slate-700 text-white'
                        : 'text-slate-300 hover:bg-slate-800 hover:text-white'
                    }`}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="px-3 pb-6 lg:mt-auto">
          <a
            href="/admin/logout"
            class="flex items-center rounded-lg px-3 py-2.5 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-800 hover:text-white"
          >
            Log out
          </a>
        </div>
      </aside>

      <div class="flex-1">
        <header class="border-b border-slate-200 bg-white/85 backdrop-blur">
          <div class="px-4 py-4 sm:px-6 lg:px-10">
            <h1 class="text-lg font-semibold text-slate-900">{title}</h1>
          </div>
        </header>

        <main class="px-4 py-6 sm:px-6 lg:px-10 lg:py-8">
          <slot />
        </main>

        <footer class="border-t border-slate-200 px-4 py-4 text-xs text-slate-500 sm:px-6 lg:px-10">
          EGAC Admin - &copy; {new Date().getFullYear()} East Grinstead Athletics Club
        </footer>
      </div>
    </div>
  </body>
</html>
