---
// src/layouts/AdminBase.astro
// Base layout for all admin pages.

interface Props {
  title: string;
  activeNav?:
    | 'dashboard'
    | 'enquiries'
    | 'bookings'
    | 'academy'
    | 'memberships'
    | 'templates'
    | 'settings';
}

import '../styles/tailwind.css';

const { title, activeNav } = Astro.props;

const navItems: Array<{ id: NonNullable<Props['activeNav']>; label: string; href: string }> = [
  { id: 'dashboard', label: 'Dashboard', href: '/admin/reports' },
  { id: 'enquiries', label: 'Enquiries', href: '/admin/enquiries' },
  { id: 'bookings', label: 'Bookings', href: '/admin/bookings' },
  { id: 'academy', label: 'Academy', href: '/admin/academy' },
  { id: 'memberships', label: 'Memberships', href: '/admin/memberships' },
  { id: 'templates', label: 'Templates', href: '/admin/templates' },
  { id: 'settings', label: 'Settings', href: '/admin/settings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — EGAC Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#eff2f7] text-slate-900 antialiased">
    <div class="relative min-h-screen lg:flex">
      <aside
        class="w-full border-b border-[#1f457f] bg-[#214c8f] text-slate-100 lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-60 lg:flex-col lg:border-b-0 lg:border-r lg:border-[#1f457f]"
      >
        <div class="px-5 py-7 border-b border-[#2f5ca0]">
          <a
            href="/admin/enquiries"
            class="text-2xl font-bold tracking-tight text-white hover:text-slate-100"
          >
            EGAC
          </a>
        </div>

        <nav class="px-3 py-4" aria-label="Admin navigation">
          <ul class="space-y-1">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class={`flex items-center gap-2 rounded-md px-3 py-2.5 text-sm font-medium transition-colors ${
                      activeNav === item.id
                        ? 'bg-[#2d5ea5] text-white'
                        : 'text-[#d9e4f6] hover:bg-[#2d5ea5] hover:text-white'
                    }`}
                  >
                    <span
                      class="inline-block h-2 w-2 rounded-full bg-current opacity-80"
                      aria-hidden="true"
                    />
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div
          class="hidden lg:block lg:mt-auto border-t border-[#2f5ca0] px-5 py-5 text-xs text-[#d9e4f6]"
        >
          <p class="font-medium">EGAC Admin</p>
          <p class="mt-2 flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-400"></span>Production
          </p>
          <a
            href="/admin/logout"
            class="mt-4 inline-block text-[#d9e4f6] underline-offset-2 hover:underline">Log out</a
          >
        </div>
      </aside>

      <div class="flex-1">
        <main class="px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
