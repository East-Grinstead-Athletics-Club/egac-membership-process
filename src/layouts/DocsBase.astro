---
interface Props {
  title: string;
  section?: string;
}
const { title, section = '' } = Astro.props;

const nav = [
  { group: 'Getting started', items: [
    { href: '/docs', label: 'Overview' },
    { href: '/docs/architecture', label: 'Architecture' },
    { href: '/docs/local-development', label: 'Local development' },
    { href: '/docs/deployment', label: 'Deployment' },
  ]},
  { group: 'Core concepts', items: [
    { href: '/docs/age-rules', label: 'UK Athletics age rules' },
    { href: '/docs/enquiry-routing', label: 'Enquiry routing' },
    { href: '/docs/database', label: 'Database schema' },
    { href: '/docs/config', label: 'Configuration' },
  ]},
  { group: 'Platform layers', items: [
    { href: '/docs/business-logic', label: 'Business logic' },
    { href: '/docs/repositories', label: 'Repositories' },
    { href: '/docs/api', label: 'API reference' },
    { href: '/docs/email', label: 'Email service' },
  ]},
  { group: 'Features', items: [
    { href: '/docs/admin-portal', label: 'Admin portal' },
    { href: '/docs/coach-app', label: 'Coach app' },
    { href: '/docs/cron-jobs', label: 'Cron jobs' },
    { href: '/docs/security', label: 'Security' },
  ]},
  { group: 'Operations', items: [
    { href: '/docs/testing', label: 'Testing' },
    { href: '/docs/pending', label: 'Pending work' },
  ]},
];

const current = Astro.url.pathname.replace(/\/$/, '');
---
<!doctype html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — EGAC Docs</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
    mermaid.initialize({
      startOnLoad: true,
      theme: 'base',
      themeVariables: {
        primaryColor: '#1F4788',
        primaryTextColor: '#ffffff',
        primaryBorderColor: '#2E75B6',
        lineColor: '#94a3b8',
        secondaryColor: '#EFF6FF',
        tertiaryColor: '#f8fafc',
        mainBkg: '#EFF6FF',
        nodeBorder: '#2E75B6',
        clusterBkg: '#f1f5f9',
        titleColor: '#1F4788',
        edgeLabelBackground: '#f8fafc',
        fontFamily: 'ui-sans-serif, system-ui, sans-serif',
        fontSize: '14px',
      },
      flowchart: { curve: 'basis', padding: 20 },
      sequence: { actorMargin: 60 },
    });
  </script>
  <style>
    .prose h1{font-size:1.875rem;font-weight:700;color:#1F4788;margin-bottom:.5rem;margin-top:2rem;padding-bottom:.5rem;border-bottom:2px solid #e2e8f0}
    .prose h1:first-child{margin-top:0}
    .prose h2{font-size:1.375rem;font-weight:600;color:#1e3a5f;margin-top:2rem;margin-bottom:.5rem}
    .prose h3{font-size:1.125rem;font-weight:600;color:#2E75B6;margin-top:1.5rem;margin-bottom:.375rem}
    .prose h4{font-size:1rem;font-weight:600;color:#334155;margin-top:1.25rem;margin-bottom:.25rem}
    .prose p{color:#374151;line-height:1.75;margin-bottom:1rem}
    .prose ul{list-style-type:disc;padding-left:1.5rem;margin-bottom:1rem}
    .prose ul li{color:#374151;margin-bottom:.25rem;line-height:1.6}
    .prose ol{list-style-type:decimal;padding-left:1.5rem;margin-bottom:1rem}
    .prose ol li{color:#374151;margin-bottom:.25rem;line-height:1.6}
    .prose code{background:#f1f5f9;color:#1F4788;padding:.15rem .4rem;border-radius:.25rem;font-size:.875em;font-family:'Courier New',monospace}
    .prose pre{background:#1e293b;color:#e2e8f0;padding:1.25rem;border-radius:.5rem;overflow-x:auto;margin-bottom:1.25rem;font-size:.875rem;line-height:1.6}
    .prose pre code{background:none;color:inherit;padding:0;font-size:inherit}
    .prose table{width:100%;border-collapse:collapse;margin-bottom:1.25rem;font-size:.875rem}
    .prose th{background:#1F4788;color:#fff;padding:.5rem .75rem;text-align:left;font-weight:600}
    .prose td{padding:.5rem .75rem;border-bottom:1px solid #e2e8f0;color:#374151;vertical-align:top}
    .prose tr:nth-child(even) td{background:#f8fafc}
    .prose a{color:#2E75B6;text-decoration:underline}
    .prose a:hover{color:#1F4788}
    .prose blockquote{border-left:4px solid #2E75B6;padding:.75rem 1rem;background:#EFF6FF;border-radius:0 .375rem .375rem 0;margin-bottom:1rem}
    .prose blockquote p{color:#1e3a5f;margin-bottom:0}
    .prose hr{border:none;border-top:1px solid #e2e8f0;margin:2rem 0}
    .mermaid{margin:1.5rem 0;text-align:center}
    .mermaid svg{max-width:100%;height:auto}
  </style>
</head>
<body class="h-full bg-white font-sans antialiased flex">

  <!-- Sidebar -->
  <aside style="width:256px;flex-shrink:0" class="border-r border-slate-200 bg-slate-50 flex flex-col overflow-y-auto h-screen sticky top-0">
    <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
      <a href="/docs" class="flex items-center gap-2.5">
        <div class="w-8 h-8 bg-blue-900 rounded-lg flex items-center justify-center">
          <span class="text-white font-black text-xs">EG</span>
        </div>
        <div>
          <p class="font-bold text-slate-800 text-sm leading-tight">EGAC Docs</p>
          <p class="text-slate-400 text-xs">Platform wiki</p>
        </div>
      </a>
    </div>
    <nav class="flex-1 px-3 py-4 overflow-y-auto space-y-5">
      {nav.map(sec => (
        <div>
          <p class="px-2 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-slate-400">{sec.group}</p>
          <ul class="space-y-0.5">
            {sec.items.map(item => {
              const active = current === item.href;
              return (
                <li>
                  <a href={item.href} class={`block px-2 py-1.5 rounded text-sm transition-colors ${active ? 'bg-blue-100 text-blue-800 font-semibold' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}`}>
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </nav>
    <div class="px-4 py-3 border-t border-slate-200 text-xs text-slate-400 space-y-0.5">
      <p>v1.0 · March 2026</p>
      <p>231 tests · 0 lint warnings</p>
      <p class="text-amber-600 font-medium">🔒 Internal — EGAC only</p>
    </div>
  </aside>

  <!-- Content -->
  <div class="flex-1 flex flex-col min-w-0 h-screen overflow-y-auto">
    <header class="sticky top-0 z-10 bg-white border-b border-slate-200 px-8 py-3 flex items-center justify-between">
      <div class="text-sm text-slate-500 flex items-center gap-2">
        <a href="/docs" class="hover:text-blue-700">Docs</a>
        {section && <><span class="text-slate-300">/</span><span class="text-slate-700">{section}</span></>}
      </div>
      <span class="text-xs bg-slate-100 text-slate-500 px-2 py-1 rounded">East Grinstead Athletics Club</span>
    </header>
    <main class="flex-1 max-w-4xl w-full mx-auto px-8 py-10">
      <article class="prose max-w-none">
        <slot />
      </article>
    </main>
  </div>

</body>
</html>
