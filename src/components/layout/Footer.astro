---
const tagline = "A community-led club dedicated to providing high-quality athletics coaching and competition opportunities for all ages and abilities.";
const email = "secretary@eastgrinsteadac.co.uk";
const year = new Date().getFullYear();
---

<footer class="bg-slate-50 dark:bg-slate-950 w-full rounded-t-[2rem] mt-12">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-12 px-8 py-16 max-w-7xl mx-auto">
    <div class="col-span-1 md:col-span-2">
      <span class="text-xl font-bold text-blue-800 dark:text-white mb-4 block font-headline">East Grinstead Athletics Club</span>
      <p class="text-slate-500 dark:text-slate-400 font-['DM_Sans'] text-sm leading-relaxed max-w-sm mb-6">
        {tagline}
      </p>
    </div>

    <div>
      <h4 class="font-bold text-on-surface dark:text-white mb-6">Quick Links</h4>
      <ul class="space-y-4 font-['DM_Sans'] text-sm">
        <li><a class="text-slate-500 hover:text-blue-600 hover:translate-x-1 transition-all inline-block" href="/">Register Interest</a></li>
        <li><a class="text-slate-500 hover:text-blue-600 hover:translate-x-1 transition-all inline-block" href="/">Book a Taster</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-on-surface dark:text-white mb-6">Contact</h4>
      <ul class="space-y-4 font-['DM_Sans'] text-sm">
        <li>
          <a
            class="text-slate-500 hover:text-blue-600 hover:translate-x-1 transition-all inline-block break-all"
            href={`mailto:${email}`}
          >
            {email}
          </a>
        </li>
        <li class="pt-4">
          <div class="bg-surface-container dark:bg-slate-800 p-4 rounded-lg">
            <span class="text-xs font-bold text-primary dark:text-blue-400 block mb-1">Need help?</span>
            <a class="text-xs text-on-surface-variant dark:text-slate-400 underline" href={`mailto:${email}`}>Contact the secretary</a>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-8 py-8 border-t border-slate-200 dark:border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-400">
    <p>© {year} East Grinstead Athletics Club. All rights reserved.</p>
    <div class="flex gap-8">
      <a class="hover:text-primary transition-colors" href="#">Privacy Policy</a>
      <a class="hover:text-primary transition-colors" href="#">Terms of Service</a>
    </div>
  </div>
</footer>
