---
const navLinks = [
  { label: "Join", href: "/" },
  { label: "Book a Taster", href: "/" },
  { label: "Contact", href: "mailto:secretary@eastgrinsteadac.co.uk" },
];

const currentPath = Astro.url.pathname;
---

<nav class="fixed top-0 w-full z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl shadow-sm dark:shadow-none">
  <div class="flex justify-between items-center w-full px-6 py-4 max-w-7xl mx-auto">
    <a href="/" class="text-2xl font-black text-blue-700 dark:text-blue-400 tracking-tighter font-headline">
      East Grinstead AC
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-8" role="navigation" aria-label="Main navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`font-headline font-bold tracking-tight text-sm uppercase transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary ${
            currentPath === link.href
              ? "text-blue-700 dark:text-yellow-400 border-b-2 border-yellow-400 pb-1"
              : "text-slate-600 dark:text-slate-300 hover:text-blue-700 dark:hover:text-yellow-400"
          }`}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-4">
      <button
        id="dark-mode-toggle"
        class="material-symbols-outlined p-2 text-on-surface-variant hover:bg-blue-50 dark:hover:bg-slate-800 rounded-lg transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        aria-label="Toggle dark mode"
      >
        dark_mode
      </button>
      <a
        href="/"
        class="hidden md:block bg-primary-container text-white px-6 py-2 rounded-lg font-bold hover:scale-95 active:scale-90 transition-transform focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        Register
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden p-2 text-on-surface-variant hover:bg-blue-50 dark:hover:bg-slate-800 rounded-lg transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        aria-label="Open mobile menu"
        aria-expanded="false"
      >
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-slate-200 dark:border-slate-700 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl"
    role="navigation"
    aria-label="Mobile navigation"
  >
    <div class="flex flex-col px-6 py-4 gap-4">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="font-headline font-bold tracking-tight text-sm uppercase text-slate-600 dark:text-slate-300 hover:text-blue-700 dark:hover:text-yellow-400 transition-colors py-2"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  // Dark mode toggle
  const toggle = document.getElementById('dark-mode-toggle');
  const html = document.documentElement;

  toggle?.addEventListener('click', () => {
    const isDark = html.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    if (toggle instanceof HTMLElement) {
      toggle.textContent = isDark ? 'light_mode' : 'dark_mode';
    }
  });

  // Set initial icon
  const currentTheme = localStorage.getItem('theme') ?? 'light';
  if (toggle instanceof HTMLElement) {
    toggle.textContent = currentTheme === 'dark' ? 'light_mode' : 'dark_mode';
  }

  // Mobile menu
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileToggle?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    mobileToggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
