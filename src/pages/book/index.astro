---
// src/pages/book/index.astro
// Shown when someone visits /book without a token — e.g. a truncated link.

import Base from '../../layouts/PublicLayout.astro';
---

<Base
  title="Book a taster session"
  description="Book your child's taster session at East Grinstead Athletics Club."
>
  <section class="pt-32 pb-16 bg-primary text-white overflow-hidden relative">
    <div
      class="absolute top-0 right-0 w-1/3 h-full bg-primary-container opacity-20 -skew-x-12 translate-x-1/2"
      aria-hidden="true"
    >
    </div>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <h1 class="text-5xl md:text-6xl font-headline font-bold mb-6">Book Your Taster Session</h1>
      <p class="text-xl text-on-primary-container max-w-2xl leading-relaxed">
        Choose a date that works for you. Sessions are held weekly and places are limited.
      </p>
    </div>
  </section>

  <div class="bg-surface-container-low">
    <div class="max-w-2xl mx-auto px-6 py-16">
      <div class="bg-surface rounded-xl shadow-md p-8 md:p-12">
        <div class="text-center">
          <div
            class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-secondary-container mb-6"
          >
            <svg
              class="w-8 h-8 text-on-secondary-container"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
              ></path>
            </svg>
          </div>
          <h2 class="text-2xl md:text-3xl font-headline font-bold text-on-surface mb-4">
            You need a booking link
          </h2>
          <p class="text-on-surface-variant max-w-md mx-auto mb-8 text-base leading-relaxed">
            Booking links are sent by email once your enquiry has been reviewed. If you've
            registered your interest, check your inbox for a message from us.
          </p>

          <div class="space-y-4 mb-8">
            <p class="text-sm text-on-surface-variant">Haven't registered yet?</p>
            <a
              href="/"
              class="inline-flex items-center justify-center bg-primary text-white px-8 py-3 rounded-lg font-headline font-bold hover:bg-primary/90 active:scale-95 transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              Register Your Interest
            </a>
          </div>

          <div class="border-t border-outline pt-6">
            <p class="text-sm text-on-surface-variant mb-3">Think something's gone wrong?</p>
            <a
              href="mailto:secretary@eastgrinsteadac.co.uk"
              class="inline-flex items-center gap-2 text-primary font-medium hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                ></path>
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
              </svg>
              Contact the secretary
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>
