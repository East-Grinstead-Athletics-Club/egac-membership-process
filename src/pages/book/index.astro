---
// src/pages/book/index.astro
// Shown when someone visits /book without a token — e.g. a truncated link.

import Base from '../../layouts/PublicLayout.astro';
---

<Base
  title="Book a taster session"
  description="Book your child's taster session at East Grinstead Athletics Club."
>
  <section class="pt-32 pb-16 bg-primary text-white overflow-hidden relative">
    <div
      class="absolute top-0 right-0 w-1/3 h-full bg-primary-container opacity-20 -skew-x-12 translate-x-1/2"
      aria-hidden="true"
    >
    </div>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <h1 class="text-5xl md:text-6xl font-headline font-bold mb-6">Book Your Taster Session</h1>
      <p class="text-xl text-on-primary-container max-w-2xl leading-relaxed">
        Choose a date that works for you. Sessions are held weekly and places are limited.
      </p>
    </div>
  </section>

  <div class="bg-surface">
    <div class="max-w-2xl mx-auto px-6 py-12">
      <div class="text-center py-10">
        <div
          class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-secondary-container mb-4"
        >
          <svg
            class="w-7 h-7 text-on-secondary-container"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
            ></path>
          </svg>
        </div>
        <h2 class="text-xl font-headline font-bold text-on-surface mb-2">
          You need a booking link
        </h2>
        <p class="text-on-surface-variant max-w-sm mx-auto mb-6">
          Booking links are sent by email once your enquiry has been reviewed. If you've registered
          your interest, check your inbox for a message from us.
        </p>
        <p class="text-sm text-on-surface-variant">
          Haven't registered yet?
          <a href="/" class="text-primary underline font-medium">Register your interest here</a>.
        </p>
        <p class="mt-3 text-sm text-on-surface-variant">
          Think something's gone wrong?
          <a href="mailto:secretary@eastgrinsteadac.co.uk" class="text-primary underline">
            Get in touch
          </a>.
        </p>
      </div>
    </div>
  </div>
</Base>
