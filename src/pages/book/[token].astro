---
// src/pages/book/[token].astro
// Taster session booking page — personalised invite link.
// SSR: validates token, fetches available sessions with capacity server-side.

import Layout from '../../layouts/Layout.astro';
import { formatDateForDisplay } from '../../lib/business/age';
import { getInviteByToken, markInviteAccepted } from '../../lib/repositories/invites';
import { getAgeGroupById } from '../../lib/repositories/age-groups';
import { createBooking, countBookingsForDateAndGroup } from '../../lib/repositories/bookings';
import { getNextNSessionDates } from '../../lib/business/age';
import { getConfig } from '../../lib/config';
import { sendBookingConfirmation } from '../../lib/email/templates';
import { isInviteExpired } from '../../lib/business/tokens';
import { getEnquiryById } from '../../lib/repositories/enquiries';
import type { Env } from '../../lib/db/schema';

const env = Astro.locals.runtime?.env as Env;
const { token } = Astro.params;

// ---- Types ----
interface SessionSlot {
  date: string;
  displayDate: string;
  time: string;
  available: number;
  capacity: number;
  full: boolean;
}

// ---- State ----
type PageError = 'not_found' | 'expired' | 'used' | null;
let pageError: PageError = null;
let bookingResult: { success: boolean; date?: string; displayDate?: string; error?: string } | null = null;
let sessions: SessionSlot[] = [];
let ageGroupLabel = '';
let sessionTime   = '';
let expiresAt     = '';
let childName     = '';
let parentEmail   = '';

// ---- Load invite ----
const invite = token ? await getInviteByToken(token, env) : null;

if (!invite) {
  pageError = 'not_found';
} else if (invite.status === 'accepted') {
  pageError = 'used';
} else if (invite.status === 'expired' || isInviteExpired(invite.expires_at)) {
  pageError = 'expired';
}

// ---- Enrich + build session list ----
if (!pageError && invite) {
  const ageGroup = await getAgeGroupById(invite.age_group_id, env);
  const enquiry  = await getEnquiryById(invite.enquiry_id, env);
  const config   = await getConfig(env);
  const weeksAhead = parseInt(config.weeks_ahead_booking ?? '8', 10);

  ageGroupLabel = ageGroup?.label    ?? '';
  sessionTime   = ageGroup?.session_time ?? '';
  expiresAt     = invite.expires_at;
  childName     = enquiry?.child_name ?? '';
  parentEmail   = enquiry?.email      ?? '';

  if (ageGroup) {
    const dates    = getNextNSessionDates(ageGroup, weeksAhead, new Date().toISOString().split('T')[0]);
    const capacity = ageGroup.capacity_per_session ?? 2;

    for (const date of dates) {
      const booked    = await countBookingsForDateAndGroup(date, ageGroup.id, env);
      const available = Math.max(0, capacity - booked);
      sessions.push({
        date,
        displayDate: formatDateForDisplay(date),
        time: sessionTime,
        available,
        capacity,
        full: available === 0,
      });
    }
  }
}

// ---- Handle booking POST ----
if (Astro.request.method === 'POST' && !pageError && invite) {
  const formData    = await Astro.request.formData();
  const sessionDate = formData.get('session_date')?.toString();

  if (!sessionDate) {
    bookingResult = { success: false, error: 'Please select a session date.' };
  } else {
    const ageGroup = await getAgeGroupById(invite.age_group_id, env);
    const capacity = ageGroup?.capacity_per_session ?? 2;
    const booked   = ageGroup ? await countBookingsForDateAndGroup(sessionDate, ageGroup.id, env) : capacity;

    if (booked >= capacity) {
      bookingResult = { success: false, error: 'Sorry, that session just filled up. Please choose another date.' };
    } else {
      try {
        await createBooking({
          invite_id:    invite.id,
          enquiry_id:   invite.enquiry_id,
          age_group_id: invite.age_group_id,
          session_date: sessionDate,
          environment:  env.APP_ENV,
        }, env);

        await markInviteAccepted(invite.id, env);

        try { await sendBookingConfirmation(invite.enquiry_id, sessionDate, env); } catch { /* non-fatal */ }

        bookingResult = { success: true, date: sessionDate, displayDate: formatDateForDisplay(sessionDate) };
      } catch {
        bookingResult = { success: false, error: 'Could not complete your booking. Please try again.' };
      }
    }
  }
}

// ---- Calendar link ----
function buildCalendarLink(date: string, time: string, label: string): string {
  const [year, month, day] = date.split('-');
  const [hh, mm]           = time.split(':');
  const dtStart = `${year}${month}${day}T${hh}${mm}00`;
  const endHour = String(parseInt(hh) + 1).padStart(2, '0');
  const dtEnd   = `${year}${month}${day}T${endHour}${mm}00`;
  const p = new URLSearchParams({
    action:   'TEMPLATE',
    text:     `EGAC ${label} Taster Session`,
    dates:    `${dtStart}/${dtEnd}`,
    details:  'Taster session at East Grinstead Athletics Club. Please arrive 5 minutes early.',
    location: 'East Grinstead Athletics Club',
  });
  return `https://calendar.google.com/calendar/render?${p}`;
}
---

<Layout title="Book a Taster Session">

  {/* ── Not found ── */}
  {pageError === 'not_found' && (
    <div class="card" style="margin-top:2rem;text-align:center">
      <p class="page-eyebrow">Invalid link</p>
      <h1 class="page-title" style="font-size:1.8rem">Link not recognised</h1>
      <p class="page-subtitle">
        This booking link doesn't exist or may have been copied incorrectly.
        Please check your email and try again.
      </p>
      <a href="/" class="btn btn-outline">Back to home</a>
    </div>
  )}

  {/* ── Expired ── */}
  {pageError === 'expired' && (
    <div class="card" style="margin-top:2rem;text-align:center">
      <p class="page-eyebrow">Link expired</p>
      <h1 class="page-title" style="font-size:1.8rem">This link has expired</h1>
      <p class="page-subtitle">
        Booking links are valid for 14 days. Please contact us to request a new link.
      </p>
      <a href="/" class="btn btn-outline">Back to home</a>
    </div>
  )}

  {/* ── Already used ── */}
  {pageError === 'used' && (
    <div class="card" style="margin-top:2rem">
      <div class="confirm-icon confirm-icon-success">
        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <p class="page-eyebrow">Already booked</p>
      <h1 class="page-title" style="font-size:1.8rem">You've already booked</h1>
      <p class="page-subtitle">
        This invite has already been used. Check your email for your booking confirmation.
        If you have a problem, please contact us.
      </p>
    </div>
  )}

  {/* ── Booking confirmed ── */}
  {!pageError && bookingResult?.success && (
    <div class="card" style="margin-top:2rem">
      <div class="confirm-icon confirm-icon-success">
        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <p class="page-eyebrow">Booking confirmed</p>
      <h1 class="page-title" style="font-size:1.9rem">See you on the track!</h1>
      <p style="color:var(--muted);margin-bottom:1.5rem">
        We've confirmed <strong>{childName}</strong>'s taster session and sent a confirmation
        to <strong>{parentEmail}</strong>.
      </p>

      <div class="info-row">
        <div class="info-item">
          <span class="info-label">Athlete</span>
          <span class="info-value">{childName}</span>
        </div>
        <div class="info-item">
          <span class="info-label">Group</span>
          <span class="info-value">{ageGroupLabel}</span>
        </div>
        <div class="info-item">
          <span class="info-label">Date</span>
          <span class="info-value">{bookingResult.displayDate}</span>
        </div>
        <div class="info-item">
          <span class="info-label">Time</span>
          <span class="info-value">{sessionTime}</span>
        </div>
      </div>

      <hr class="divider" />

      <div class="alert alert-info" style="margin-bottom:1.25rem">
        <strong>What to bring:</strong> suitable trainers, water bottle, and comfortable sportswear.
        Please arrive 5–10 minutes before your session time.
      </div>

      <a
        href={buildCalendarLink(bookingResult.date!, sessionTime, ageGroupLabel)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline"
      >
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        Add to Google Calendar
      </a>
    </div>
  )}

  {/* ── Booking form ── */}
  {!pageError && !bookingResult?.success && invite && (
    <>
      <p class="page-eyebrow">Taster session invite</p>
      <h1 class="page-title">Choose your session</h1>
      <p class="page-subtitle">
        Select a Tuesday evening that works for <strong>{childName}</strong>.
        Places are limited — book as soon as you can.
      </p>

      {bookingResult?.error && (
        <div class="alert alert-error" style="margin-bottom:1.25rem">{bookingResult.error}</div>
      )}

      <div class="card">
        <div class="info-row" style="margin-bottom:1.25rem;padding-bottom:1.25rem;border-bottom:1px solid var(--border)">
          <div class="info-item">
            <span class="info-label">Athlete</span>
            <span class="info-value">{childName}</span>
          </div>
          <div class="info-item">
            <span class="info-label">Age group</span>
            <span class="info-value">{ageGroupLabel}</span>
          </div>
          <div class="info-item">
            <span class="info-label">Session time</span>
            <span class="info-value">{sessionTime}</span>
          </div>
        </div>

        <form method="POST" id="booking-form" novalidate>
          <p style="font-size:0.78rem;font-weight:700;letter-spacing:0.09em;text-transform:uppercase;color:var(--muted);margin-bottom:0.75rem">
            Available Tuesdays
          </p>

          {sessions.length === 0 && (
            <div class="alert alert-warning">
              No upcoming sessions are available right now. Please contact us.
            </div>
          )}

          <div class="session-list" role="group" aria-label="Available session dates">
            {sessions.map((s) => (
              <button
                type="button"
                class="session-option"
                data-date={s.date}
                disabled={s.full}
                aria-label={`${s.displayDate} at ${s.time} — ${s.full ? 'Full' : `${s.available} place${s.available !== 1 ? 's' : ''} left`}`}
              >
                <div style="flex:1">
                  <div class="session-date">{s.displayDate}</div>
                  <div class="session-time">{s.time}</div>
                </div>
                <span class={`session-badge ${s.full ? 'badge-full' : 'badge-available'}`}>
                  {s.full ? 'Full' : `${s.available} left`}
                </span>
              </button>
            ))}
          </div>

          <input type="hidden" name="session_date" id="selected_date" value="" />

          <div id="date-error" class="alert alert-error" style="display:none;margin-top:1rem">
            Please select a session date.
          </div>

          <hr class="divider" />

          <button type="submit" class="btn btn-primary btn-block" id="submit-btn"
            style="font-size:1.05rem;padding:1rem" disabled>
            Confirm booking &rarr;
          </button>
        </form>
      </div>

      <p style="font-size:0.82rem;color:var(--muted);margin-top:1rem;text-align:center">
        This link expires on {new Date(expiresAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}.
      </p>
    </>
  )}

</Layout>

<script>
  const options   = document.querySelectorAll<HTMLButtonElement>('.session-option');
  const hidden    = document.getElementById('selected_date') as HTMLInputElement | null;
  const submitBtn = document.getElementById('submit-btn')    as HTMLButtonElement | null;
  const dateErr   = document.getElementById('date-error')    as HTMLElement | null;
  const form      = document.getElementById('booking-form')  as HTMLFormElement | null;

  options.forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.disabled) return;
      options.forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      if (hidden)    hidden.value       = btn.dataset.date ?? '';
      if (submitBtn) submitBtn.disabled = false;
      if (dateErr)   dateErr.style.display = 'none';
    });
  });

  form?.addEventListener('submit', e => {
    if (!hidden?.value) {
      e.preventDefault();
      if (dateErr) dateErr.style.display = 'block';
      return;
    }
    if (submitBtn) {
      submitBtn.disabled    = true;
      submitBtn.textContent = 'Confirming…';
    }
  });
</script>
