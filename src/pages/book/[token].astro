---
// src/pages/book/[token].astro
// Invite-based taster session booking page.
// Loads invite server-side, shows available dates with capacity, handles booking.

import Base from '../../layouts/PublicLayout.astro';
import { getInviteByToken } from '../../lib/repositories/invites.js';
import { getEnquiryById } from '../../lib/repositories/enquiries.js';
import { listAgeGroups } from '../../lib/repositories/age-groups.js';
import { countBookingsForDateAndGroup } from '../../lib/repositories/bookings.js';
import {
  resolveAgeGroup,
  getNextNSessionDates,
  formatDateForDisplay,
} from '../../lib/business/age.js';
import { getSystemConfig, getWeeksAhead } from '../../lib/config.js';

// ── Server-side data loading ────────────────────────────────────────────────

const { token } = Astro.params;
const env = Astro.locals.runtime.env;

type DateSlot = {
  date: string;
  displayDate: string;
  booked: number;
  capacity: number;
  full: boolean;
};

// These are populated only on a valid invite
let enquiryName = '';
let ageGroupLabel = '';
let sessionTime = '';
let availableDates: DateSlot[] = [];
let adminEmail = 'info@eastgrinsteadac.org.uk';
let venueName = 'East Grinstead Leisure Centre';

// State flags
let expired = false;
let alreadyBooked = false;

if (!token) {
  expired = true;
} else {
  try {
    const config = await getSystemConfig(env);
    adminEmail = config.admin_email || adminEmail;
    venueName = config.venue_name || venueName;

    const invite = await getInviteByToken(token, env);

    if (!invite || invite.status === 'expired') {
      expired = true;
    } else if (invite.status === 'accepted') {
      alreadyBooked = true;
    } else if (invite.status !== 'sent') {
      expired = true;
    } else {
      // Valid invite — load enquiry and build date list
      const enquiry = await getEnquiryById(invite.enquiry_id, env);
      if (!enquiry) {
        expired = true;
      } else {
        enquiryName = enquiry.name ?? 'there';

        const allGroups = await listAgeGroups(env);
        const today = new Date().toISOString().split('T')[0];
        const ageGroup = resolveAgeGroup(enquiry.dob, today, allGroups);

        ageGroupLabel = ageGroup?.label ?? 'Taster session';
        sessionTime = ageGroup?.session_time ?? '';

        const weeksAhead = getWeeksAhead(config);
        const capacity = ageGroup?.capacity_per_session ?? 2;

        if (ageGroup) {
          const dates = getNextNSessionDates(ageGroup, weeksAhead);
          const withCapacity = await Promise.all(
            dates.map(async (date) => {
              const booked = await countBookingsForDateAndGroup(date, ageGroup.id, env);
              return {
                date,
                displayDate: formatDateForDisplay(date),
                booked,
                capacity,
                full: booked >= capacity,
              };
            })
          );
          availableDates = withCapacity;
        }
      }
    }
  } catch (err) {
    console.error(
      JSON.stringify({ level: 'error', event: 'booking_page_error', error: String(err) })
    );
    expired = true;
  }
}
---

<Base
  title="Book a taster session"
  description="Book your child's taster session at East Grinstead Athletics Club."
>
  <section class="pt-32 pb-16 bg-primary text-white overflow-hidden relative">
    <div
      class="absolute top-0 right-0 w-1/3 h-full bg-primary-container opacity-20 -skew-x-12 translate-x-1/2"
      aria-hidden="true"
    >
    </div>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <h1 class="text-5xl md:text-6xl font-headline font-bold mb-6">Book Your Taster Session</h1>
      <p class="text-xl text-on-primary-container max-w-2xl leading-relaxed">
        Choose a date that works for you. Sessions are held weekly and places are limited — book
        early to secure your spot.
      </p>
    </div>
  </section>

  <div class="bg-surface-container-low">
    <div class="max-w-2xl mx-auto px-6 py-12">
      {
        expired && (
          <div class="text-center py-10">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-error-container/30 mb-4">
              <svg
                class="w-7 h-7 text-error"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
                />
              </svg>
            </div>
            <h1 class="text-xl font-headline font-bold text-on-surface mb-2">
              This link has expired
            </h1>
            <p class="text-on-surface-variant max-w-sm mx-auto">
              This booking link has expired or has already been used. Please contact us and we can
              send you a new one.
            </p>
            <p class="mt-4">
              <a
                href={`mailto:${adminEmail}`}
                class="text-primary underline text-sm hover:text-primary/80 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                {adminEmail}
              </a>
            </p>
          </div>
        )
      }

      {
        alreadyBooked && (
          <div class="text-center py-10">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-secondary-container/30 mb-4">
              <svg
                class="w-7 h-7 text-on-secondary-container"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                />
              </svg>
            </div>
            <h1 class="text-xl font-headline font-bold text-on-surface mb-2">
              You're already booked in
            </h1>
            <p class="text-on-surface-variant max-w-sm mx-auto">
              This booking link has already been used. Check your email for your session
              confirmation.
            </p>
            <p class="mt-4">
              <a
                href={`mailto:${adminEmail}`}
                class="text-primary underline text-sm hover:text-primary/80 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                Contact us if you need to make changes
              </a>
            </p>
          </div>
        )
      }

      {
        !expired && !alreadyBooked && (
          <div>
            <h1 class="text-2xl font-headline font-bold text-primary mb-1">
              Book your taster session
            </h1>
            <p class="text-on-surface-variant mb-2">
              Hi <strong class="text-on-surface">{enquiryName}</strong> — choose a date below to
              book your
              <strong class="text-on-surface">{ageGroupLabel}</strong> taster session
              {sessionTime ? ` (${sessionTime})` : ''}.
            </p>
            <p class="text-sm text-on-surface-variant mb-8">Sessions are held at {venueName}.</p>

            <div
              id="booking-error"
              class="hidden bg-error-container border border-error/30 rounded-xl p-4 mb-6 text-sm text-on-error-container"
              role="alert"
              aria-live="assertive"
            />

            <form id="booking-form" class="space-y-3" novalidate>
              <fieldset>
                <legend class="text-sm font-medium text-on-surface mb-3">Choose a date</legend>

                {availableDates.length === 0 && (
                  <p class="text-on-surface-variant text-sm">
                    No upcoming sessions found. Please contact us at
                    <a href={`mailto:${adminEmail}`} class="text-primary underline">
                      {adminEmail}
                    </a>
                    .
                  </p>
                )}

                {availableDates.map((slot) => (
                  <label
                    class={`flex items-center gap-4 p-4 rounded-xl border cursor-pointer transition-colors ${
                      slot.full
                        ? 'border-outline-variant bg-surface-container text-on-surface-variant opacity-60 cursor-not-allowed'
                        : 'border-outline bg-surface-container-lowest text-on-surface hover:border-primary/50 hover:bg-primary-fixed/20 has-[:checked]:border-primary has-[:checked]:bg-primary-fixed/20'
                    }`}
                  >
                    <input
                      type="radio"
                      name="session_date"
                      value={slot.date}
                      disabled={slot.full}
                      class="accent-primary mt-0.5"
                      required
                    />
                    <div class="flex-1 min-w-0">
                      <p
                        class={`font-medium text-sm ${slot.full ? 'text-on-surface-variant' : 'text-on-surface'}`}
                      >
                        {slot.displayDate}
                      </p>
                    </div>
                    <div class="text-xs shrink-0">
                      {slot.full ? (
                        <span class="text-error font-medium">Full</span>
                      ) : (
                        <span class="text-on-surface font-medium">
                          {slot.capacity - slot.booked} place
                          {slot.capacity - slot.booked === 1 ? '' : 's'} left
                        </span>
                      )}
                    </div>
                  </label>
                ))}
              </fieldset>

              {availableDates.some((s) => !s.full) && (
                <div class="pt-2">
                  <button
                    id="book-btn"
                    type="submit"
                    class="w-full rounded-lg bg-primary-container text-white px-6 py-3 text-sm font-bold hover:scale-95 active:scale-90 disabled:opacity-60 disabled:cursor-not-allowed transition-transform focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                  >
                    Book this session
                  </button>
                </div>
              )}
            </form>

            <div id="booking-confirmation" class="hidden">
              <div class="bg-surface-container-lowest dark:bg-slate-800 rounded-xl border border-outline-variant shadow-sm p-8 text-center">
                <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-secondary-container/30 mb-5">
                  <svg
                    class="w-7 h-7 text-on-secondary-container"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                </div>
                <h2 class="text-xl font-headline font-bold text-on-surface dark:text-white mb-2">
                  You're booked in!
                </h2>
                <p
                  id="confirmation-detail"
                  class="text-on-surface-variant dark:text-slate-300 mb-6"
                />
                <a
                  id="calendar-link"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block rounded-lg border border-primary px-4 py-2 text-sm font-medium text-primary hover:bg-primary-fixed/20 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  Add to Google Calendar
                </a>
                <p class="mt-6 text-sm text-on-surface-variant dark:text-slate-400">
                  A confirmation email is on its way to you. See you there!
                </p>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</Base>

<script define:vars={{ token, venueName, sessionTime, ageGroupLabel }}>
  const form = document.getElementById('booking-form');
  const bookBtn = document.getElementById('book-btn');
  const errorEl = document.getElementById('booking-error');
  const formEl = document.querySelector('#booking-form fieldset')?.closest('form')?.parentElement;
  const confirmationEl = document.getElementById('booking-confirmation');
  const confirmationDetail = document.getElementById('confirmation-detail');
  const calendarLink = document.getElementById('calendar-link');

  if (form && bookBtn && errorEl) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      errorEl.textContent = '';

      const selected = form.querySelector('input[name="session_date"]:checked');
      if (!selected) {
        errorEl.textContent = 'Please choose a date before continuing.';
        errorEl.classList.remove('hidden');
        return;
      }

      const sessionDate = selected.value;
      bookBtn.disabled = true;
      bookBtn.textContent = 'Booking…';

      try {
        const res = await fetch('/api/booking', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, date: sessionDate }),
        });

        const json = await res.json();

        if (res.ok) {
          // Build Google Calendar link
          const dateObj = new Date(sessionDate + 'T00:00:00');
          const [startH, startM] = (sessionTime || '18:30').split(':').map(Number);
          const start = new Date(dateObj);
          start.setHours(startH, startM, 0);
          const end = new Date(start);
          end.setHours(start.getHours() + 1, start.getMinutes(), 0);

          const fmt = (d) => d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
          const gcal = new URL('https://calendar.google.com/calendar/render');
          gcal.searchParams.set('action', 'TEMPLATE');
          gcal.searchParams.set('text', `EGAC ${ageGroupLabel} Taster Session`);
          gcal.searchParams.set('dates', `${fmt(start)}/${fmt(end)}`);
          // Use venue from API response — it resolves the per-day Training Location from Settings
          const venue = json.venue || venueName;
          gcal.searchParams.set('location', venue);
          gcal.searchParams.set('details', 'East Grinstead Athletics Club taster session');

          // Format display date
          const displayDate = new Date(sessionDate + 'T12:00:00').toLocaleDateString('en-GB', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          });

          confirmationDetail.textContent = `${displayDate}${sessionTime ? ` at ${sessionTime}` : ''} · ${venue}`;
          calendarLink.href = gcal.toString();

          // Swap form for confirmation
          form.classList.add('hidden');
          confirmationEl?.classList.remove('hidden');
        } else if (res.status === 409) {
          errorEl.textContent = 'That date is now full — please choose another.';
          errorEl.classList.remove('hidden');
          bookBtn.disabled = false;
          bookBtn.textContent = 'Book this session';
        } else {
          errorEl.textContent =
            json.error ?? json.message ?? 'Something went wrong. Please try again.';
          errorEl.classList.remove('hidden');
          bookBtn.disabled = false;
          bookBtn.textContent = 'Book this session';
        }
      } catch {
        errorEl.textContent = 'Unable to book — please check your connection and try again.';
        errorEl.classList.remove('hidden');
        bookBtn.disabled = false;
        bookBtn.textContent = 'Book this session';
      }
    });
  }
</script>
