---
// src/pages/admin/enquiries.astro
// Admin enquiries list. Shows all enquiries with filtering, search and pagination.
// Auth: checks egac_admin_token cookie server-side.

import AdminBase from '../../layouts/AdminBase.astro';
import { checkAdminToken } from '../../lib/auth/admin.js';
import { listEnquiries } from '../../lib/repositories/enquiries.js';
import { getInviteById } from '../../lib/repositories/invites.js';
import { listAgeGroups } from '../../lib/repositories/age-groups.js';
import type { Enquiry, AgeGroup, Invite, EnquiryFilters } from '../../lib/db/schema.js';

// ── Auth check ───────────────────────────────────────────────────────────────

const env = Astro.locals.runtime.env;
const token = Astro.cookies.get('egac_admin_token')?.value ?? '';
if (!checkAdminToken(token, env)) {
  return Astro.redirect('/admin/login');
}

// ── URL params ───────────────────────────────────────────────────────────────

const url = new URL(Astro.request.url);
const rawStatus = url.searchParams.get('status') ?? 'all';
const search = url.searchParams.get('search')?.trim() ?? '';
const rawPage = parseInt(url.searchParams.get('page') ?? '1', 10);
const page = Number.isNaN(rawPage) || rawPage < 1 ? 1 : rawPage;
const PAGE_SIZE = 20;
const offset = (page - 1) * PAGE_SIZE;

// ── Load data ────────────────────────────────────────────────────────────────

const filters: EnquiryFilters = {
  limit: PAGE_SIZE + 1,
  offset,
  ...(rawStatus === 'pending' || rawStatus === 'processed' || rawStatus === 'academy'
    ? { status: rawStatus }
    : {}),
  ...(search ? { search } : {}),
};

const [rows, ageGroups] = await Promise.all([listEnquiries(filters, env), listAgeGroups(env)]);

const hasNextPage = rows.length > PAGE_SIZE;
const enquiries: Enquiry[] = rows.slice(0, PAGE_SIZE);

// Build age group lookup map
const ageGroupMap = new Map<string, AgeGroup>(ageGroups.map((ag) => [ag.id, ag]));

// Load invites in parallel for enquiries that have one
const inviteMap = new Map<string, Invite>();
await Promise.all(
  enquiries.map(async (e) => {
    if (!e.invite_id) return;
    const inv = await getInviteById(e.invite_id, env);
    if (inv) inviteMap.set(e.id, inv);
  })
);

// ── Helpers ──────────────────────────────────────────────────────────────────

function formatDate(iso: string): string {
  if (!iso) return '—';
  const d = new Date(iso);
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

function inviteStatusBadge(status: string | undefined): { label: string; cls: string } {
  switch (status) {
    case 'pending':
      return { label: 'Pending', cls: 'bg-yellow-100 text-yellow-800' };
    case 'sent':
      return { label: 'Sent', cls: 'bg-blue-100 text-blue-800' };
    case 'accepted':
      return { label: 'Accepted', cls: 'bg-green-100 text-green-800' };
    case 'expired':
      return { label: 'Expired', cls: 'bg-gray-100 text-gray-600' };
    case 'failed':
      return { label: 'Failed', cls: 'bg-red-100 text-red-700' };
    default:
      return { label: 'None', cls: 'bg-gray-100 text-gray-500' };
  }
}

// Build next/prev page URLs
function pageUrl(p: number): string {
  const u = new URL(Astro.request.url);
  u.searchParams.set('page', String(p));
  return u.pathname + u.search;
}

function tabUrl(s: string): string {
  const u = new URL(Astro.request.url);
  u.searchParams.set('status', s);
  u.searchParams.delete('page');
  if (search) u.searchParams.set('search', search);
  return u.pathname + u.search;
}

const tabs: { id: string; label: string }[] = [
  { id: 'all', label: 'All' },
  { id: 'pending', label: 'Pending' },
  { id: 'processed', label: 'Processed' },
  { id: 'academy', label: 'Academy' },
];

const pendingCount = enquiries.filter((enq) => !enq.processed).length;
const processedCount = enquiries.length - pendingCount;
const academyCount = enquiries.filter((enq) => enq.source.toLowerCase().includes('academy')).length;
---

<AdminBase title="Enquiries" activeNav="enquiries">
  <div class="space-y-6">
    <div class="rounded-2xl border border-slate-200 bg-white px-5 py-5 shadow-sm sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">Membership pipeline</p>
          <h2 class="mt-1 text-2xl font-semibold text-slate-900">Enquiries overview</h2>
          <p class="mt-1 text-sm text-slate-600">Review inbound enquiries and track invitation progress.</p>
        </div>
        <div class="text-right">
          <p class="text-xs uppercase tracking-wide text-slate-500">Page</p>
          <p class="text-sm font-semibold text-slate-900">{page}</p>
        </div>
      </div>

      <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Shown</p>
          <p class="mt-1 text-2xl font-semibold text-slate-900">{enquiries.length}</p>
        </div>
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-amber-700">Pending</p>
          <p class="mt-1 text-2xl font-semibold text-amber-800">{pendingCount}</p>
        </div>
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-emerald-700">Processed</p>
          <p class="mt-1 text-2xl font-semibold text-emerald-800">{processedCount}</p>
        </div>
        <div class="rounded-xl border border-sky-200 bg-sky-50 p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-sky-700">Academy</p>
          <p class="mt-1 text-2xl font-semibold text-sky-800">{academyCount}</p>
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <nav class="flex flex-wrap gap-2" aria-label="Enquiry status filter">
        {
          tabs.map((tab) => (
            <a
              href={tabUrl(tab.id)}
              class={`rounded-full px-4 py-2 text-sm font-medium transition-colors ${
                rawStatus === tab.id || (tab.id === 'all' && rawStatus === 'all')
                  ? 'bg-slate-900 text-white'
                  : 'bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-800'
              }`}
            >
              {tab.label}
            </a>
          ))
        }
        </nav>

        <form method="GET" class="flex w-full flex-col gap-2 sm:flex-row lg:w-auto">
          <input type="hidden" name="status" value={rawStatus} />
          <input
            type="search"
            name="search"
            value={search}
            placeholder="Search by name or email"
            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200 sm:min-w-72"
          />
          <div class="flex gap-2">
            <button
              type="submit"
              class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-800"
            >
              Search
            </button>
            {
              search && (
                <a
                  href={tabUrl(rawStatus)}
                  class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
                >
                  Clear
                </a>
              )
            }
          </div>
        </form>
      </div>
    </div>

    {
      enquiries.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white py-16 text-center text-sm text-slate-500 shadow-sm">
          No enquiries found.
        </div>
      ) : (
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-4 py-3 text-sm text-slate-600 sm:px-6">
            Showing {enquiries.length} enquiry{enquiries.length === 1 ? '' : 'ies'}
            {search ? ` for "${search}"` : ''}
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
              <thead class="bg-slate-50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 sm:px-6">
                    Date
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Name
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Email
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    DOB
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Age Group
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Invite
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Status
                  </th>
                  <th class="px-4 py-3" />
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 bg-white">
                {enquiries.map((enq) => {
                  const invite = inviteMap.get(enq.id);
                  const ageGroup = enq.age_group_id ? ageGroupMap.get(enq.age_group_id) : null;
                  const badge = inviteStatusBadge(invite?.status);
                  return (
                    <tr class="transition-colors hover:bg-slate-50">
                      <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600 sm:px-6">
                        {formatDate(enq.created_at)}
                      </td>
                      <td class="px-4 py-3 text-sm font-medium text-slate-900">
                        {enq.name || <span class="text-slate-400">—</span>}
                      </td>
                      <td class="px-4 py-3 text-sm text-slate-700">{enq.email}</td>
                      <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600">
                        {enq.dob ? formatDate(enq.dob) : <span class="text-slate-400">—</span>}
                      </td>
                      <td class="px-4 py-3 text-sm text-slate-600">
                        {ageGroup ? (
                          <span class="text-xs">
                            {ageGroup.label}
                            <span class="ml-1 text-slate-400">({ageGroup.booking_type})</span>
                          </span>
                        ) : (
                          <span class="text-slate-400">—</span>
                        )}
                      </td>
                      <td class="px-4 py-3">
                        <span
                          class={`inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium ${badge.cls}`}
                        >
                          {badge.label}
                        </span>
                      </td>
                      <td class="px-4 py-3">
                        <span
                          class={`inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium ${enq.processed ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}`}
                        >
                          {enq.processed ? 'Processed' : 'Pending'}
                        </span>
                      </td>
                      <td class="px-4 py-3 text-right">
                        <a
                          href={`/admin/enquiries/${enq.id}`}
                          class="text-xs font-semibold text-slate-700 transition hover:text-slate-900"
                        >
                          View details
                        </a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      )
    }

    {
      (page > 1 || hasNextPage) && (
        <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm shadow-sm sm:px-6">
          <div>
            {page > 1 ? (
              <a
                href={pageUrl(page - 1)}
                class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 transition hover:bg-slate-50"
              >
                ← Previous
              </a>
            ) : (
              <span class="px-3 py-1.5 text-slate-400">← Previous</span>
            )}
          </div>
          <span class="text-slate-500">Page {page}</span>
          <div>
            {hasNextPage ? (
              <a
                href={pageUrl(page + 1)}
                class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 transition hover:bg-slate-50"
              >
                Next →
              </a>
            ) : (
              <span class="px-3 py-1.5 text-slate-400">Next →</span>
            )}
          </div>
        </div>
      )
    }
  </div>
</AdminBase>
