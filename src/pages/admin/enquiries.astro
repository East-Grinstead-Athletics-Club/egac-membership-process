---
// src/pages/admin/enquiries.astro
// Admin enquiries list. Shows all enquiries with filtering, search and pagination.
// Auth: checks egac_admin_token cookie server-side.

import AdminBase from '../../layouts/AdminBase.astro';
import { checkAdminToken } from '../../lib/auth/admin.js';
import { listEnquiries } from '../../lib/repositories/enquiries.js';
import { getInviteById } from '../../lib/repositories/invites.js';
import { listAgeGroups } from '../../lib/repositories/age-groups.js';
import { listBookingsByEnquiry } from '../../lib/repositories/bookings.js';
import type { Enquiry, AgeGroup, Invite, EnquiryFilters } from '../../lib/db/schema.js';

// ── Auth check ───────────────────────────────────────────────────────────────

const env = Astro.locals.runtime.env;
const token = Astro.cookies.get('egac_admin_token')?.value ?? '';
if (!checkAdminToken(token, env)) {
  return Astro.redirect('/admin/login');
}

// ── URL params ───────────────────────────────────────────────────────────────

const url = new URL(Astro.request.url);
const rawStatus = url.searchParams.get('status') ?? 'all';
const search = url.searchParams.get('search')?.trim() ?? '';
const rawPage = parseInt(url.searchParams.get('page') ?? '1', 10);
const page = Number.isNaN(rawPage) || rawPage < 1 ? 1 : rawPage;
const PAGE_SIZE = 20;
const offset = (page - 1) * PAGE_SIZE;

// ── Load data ────────────────────────────────────────────────────────────────

const filters: EnquiryFilters = {
  limit: PAGE_SIZE + 1,
  offset,
  ...(rawStatus === 'pending' || rawStatus === 'processed' || rawStatus === 'academy'
    ? { status: rawStatus }
    : {}),
  ...(search ? { search } : {}),
};

const [rows, ageGroups] = await Promise.all([listEnquiries(filters, env), listAgeGroups(env)]);

const hasNextPage = rows.length > PAGE_SIZE;
const enquiries: Enquiry[] = rows.slice(0, PAGE_SIZE);

// Build age group lookup map
const ageGroupMap = new Map<string, AgeGroup>(ageGroups.map((ag) => [ag.id, ag]));

// Load invites in parallel for enquiries that have one
const inviteMap = new Map<string, Invite>();
const latestBookingStatusMap = new Map<string, string>();
await Promise.all(
  enquiries.map(async (e) => {
    const tasks: Array<Promise<void>> = [];

    if (e.invite_id) {
      tasks.push(
        (async () => {
          const inv = await getInviteById(e.invite_id, env);
          if (inv) inviteMap.set(e.id, inv);
        })()
      );
    }

    tasks.push(
      (async () => {
        const bookings = await listBookingsByEnquiry(e.id, env);
        if (bookings.length > 0) {
          const sorted = bookings
            .slice()
            .sort((a, b) =>
              `${b.session_date}T${b.created_at}`.localeCompare(`${a.session_date}T${a.created_at}`)
            );
          latestBookingStatusMap.set(e.id, sorted[0].status);
        }
      })()
    );

    await Promise.all(tasks);
  })
);

// ── Helpers ──────────────────────────────────────────────────────────────────

function formatDate(iso: string): string {
  if (!iso) return '—';
  const d = new Date(iso);
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

function inviteStatusBadge(status: string | undefined): { label: string; cls: string } {
  switch (status) {
    case 'pending':
      return { label: 'Pending', cls: 'bg-yellow-100 text-yellow-800' };
    case 'sent':
      return { label: 'Sent', cls: 'bg-blue-100 text-blue-800' };
    case 'accepted':
      return { label: 'Accepted', cls: 'bg-green-100 text-green-800' };
    case 'expired':
      return { label: 'Expired', cls: 'bg-gray-100 text-gray-600' };
    case 'failed':
      return { label: 'Failed', cls: 'bg-red-100 text-red-700' };
    default:
      return { label: 'None', cls: 'bg-gray-100 text-gray-500' };
  }
}

// Build next/prev page URLs
function pageUrl(p: number): string {
  const u = new URL(Astro.request.url);
  u.searchParams.set('page', String(p));
  return u.pathname + u.search;
}

function tabUrl(s: string): string {
  const u = new URL(Astro.request.url);
  u.searchParams.set('status', s);
  u.searchParams.delete('page');
  if (search) u.searchParams.set('search', search);
  return u.pathname + u.search;
}

const tabs: { id: string; label: string }[] = [
  { id: 'all', label: 'All' },
  { id: 'pending', label: 'Pending' },
  { id: 'processed', label: 'Processed' },
  { id: 'academy', label: 'Academy' },
];

---

<AdminBase title="Enquiries" activeNav="enquiries">
  <div class="space-y-5">
    <div class="flex items-center justify-between gap-3">
      <h1 class="text-4xl font-semibold text-slate-900">Enquiries</h1>
      <div class="flex items-center gap-3">
        <form method="GET" class="hidden md:block">
          <input type="hidden" name="status" value={rawStatus} />
          <input
            type="search"
            name="search"
            value={search}
            placeholder="Search..."
            class="w-64 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm text-slate-700 outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
          />
        </form>
        <a href="/admin/enquiries" class="rounded-xl bg-[#2d5ea5] px-5 py-2.5 text-sm font-medium text-white hover:bg-[#254f89]">New enquiry</a>
      </div>
    </div>

    <div class="border-b border-slate-300 pb-1">
      <div class="flex flex-wrap gap-5" aria-label="Enquiry status filter">
        {
          tabs.map((tab) => (
            <a
              href={tabUrl(tab.id)}
              class={`border-b-2 pb-2 text-sm font-medium transition-colors ${
                rawStatus === tab.id || (tab.id === 'all' && rawStatus === 'all')
                  ? 'border-[#2d5ea5] text-[#2d5ea5]'
                  : 'border-transparent text-slate-500 hover:text-slate-700'
              }`}
            >
              {tab.label}
            </a>
          ))
        }
      </div>
    </div>

    {
      enquiries.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white py-16 text-center text-sm text-slate-500 shadow-sm">
          No enquiries found.
        </div>
      ) : (
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
              <thead class="bg-slate-50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 sm:px-6">
                    Date
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Name
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Email
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    DOB
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Path
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Invite
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Booking
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 bg-white">
                {enquiries.map((enq) => {
                  const invite = inviteMap.get(enq.id);
                  const ageGroup = enq.age_group_id ? ageGroupMap.get(enq.age_group_id) : null;
                  const badge = inviteStatusBadge(invite?.status);
                  const isAcademy = ageGroup?.booking_type === 'waitlist' || enq.source.toLowerCase().includes('academy');
                  const latestBookingStatus = latestBookingStatusMap.get(enq.id);
                  return (
                    <tr class="transition-colors hover:bg-slate-50">
                      <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600 sm:px-6">
                        {formatDate(enq.created_at)}
                      </td>
                      <td class="px-4 py-3 text-sm font-medium text-slate-900">
                        {enq.name || <span class="text-slate-400">—</span>}
                      </td>
                      <td class="px-4 py-3 text-sm text-slate-700">{enq.email}</td>
                      <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600">
                        {enq.dob ? formatDate(enq.dob) : <span class="text-slate-400">—</span>}
                      </td>
                      <td class="px-4 py-3 text-sm text-slate-600">
                        <span class={`inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium ${isAcademy ? 'bg-violet-100 text-violet-700' : 'bg-blue-100 text-blue-700'}`}>
                          {isAcademy ? 'Academy' : 'Taster'}
                        </span>
                      </td>
                      <td class="px-4 py-3">
                        <span
                          class={`inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium ${badge.cls}`}
                        >
                          {badge.label}
                        </span>
                      </td>
                      <td class="px-4 py-3 text-sm text-slate-600">
                        {latestBookingStatus ? (
                          <span
                            class={`inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium ${
                              latestBookingStatus === 'attended'
                                ? 'bg-emerald-100 text-emerald-700'
                                : latestBookingStatus === 'no_show'
                                  ? 'bg-rose-100 text-rose-700'
                                  : latestBookingStatus === 'cancelled'
                                    ? 'bg-slate-100 text-slate-600'
                                    : 'bg-blue-100 text-blue-700'
                            }`}
                          >
                            {latestBookingStatus === 'no_show'
                              ? 'No show'
                              : latestBookingStatus.charAt(0).toUpperCase() + latestBookingStatus.slice(1)}
                          </span>
                        ) : (
                          <span class="text-slate-400">—</span>
                        )}
                      </td>
                      <td class="px-4 py-3 text-sm whitespace-nowrap">
                        <a
                          href={`/admin/enquiries/${enq.id}`}
                          class="font-medium text-[#2d5ea5] hover:underline"
                        >
                          View
                        </a>
                        <span class="mx-2 text-slate-300"> </span>
                        <a href={`/admin/enquiries/${enq.id}`} class="font-medium text-[#2d5ea5] hover:underline">
                          Resend
                        </a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      )
    }

    {
      (page > 1 || hasNextPage) && (
        <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm shadow-sm sm:px-6">
          <div>
            {page > 1 ? (
              <a
                href={pageUrl(page - 1)}
                class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 transition hover:bg-slate-50"
              >
                ← Previous
              </a>
            ) : (
              <span class="px-3 py-1.5 text-slate-400">← Previous</span>
            )}
          </div>
          <span class="text-slate-500">Page {page}</span>
          <div>
            {hasNextPage ? (
              <a
                href={pageUrl(page + 1)}
                class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 transition hover:bg-slate-50"
              >
                Next →
              </a>
            ) : (
              <span class="px-3 py-1.5 text-slate-400">Next →</span>
            )}
          </div>
        </div>
      )
    }
  </div>
</AdminBase>
