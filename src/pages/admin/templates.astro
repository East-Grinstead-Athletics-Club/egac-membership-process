---
// src/pages/admin/templates.astro
// Admin email template list — shows all templates with active
// toggle and links to the editor for each one.

import AdminBase from '../../layouts/AdminBase.astro';
import { checkAdminToken } from '../../lib/auth/admin.js';
import { listEmailTemplates } from '../../lib/repositories/templates.js';

// ── Auth ──────────────────────────────────────────────────────
const env = Astro.locals.runtime.env;
const token = Astro.cookies.get('egac_admin_token')?.value ?? '';
if (!checkAdminToken(token, env)) return Astro.redirect('/admin/login');

// ── Data ──────────────────────────────────────────────────────
const templates = await listEmailTemplates(env);

function formatDate(iso: string | null): string {
  if (!iso) return '—';
  return new Date(iso).toLocaleDateString('en-GB', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });
}
---

<AdminBase title="Email Templates" activeNav="templates">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">Email Templates</h1>
    </div>

    <p class="text-sm text-gray-500">
      These templates are used for all automated emails sent by the platform. Edit the HTML and
      subject line — use
      <code class="bg-gray-100 px-1 rounded text-xs">{`{{variable_name}}`}</code>
      placeholders for dynamic content.
    </p>

    <!-- Toast -->
    <div
      id="toast"
      class="hidden fixed top-4 right-4 z-50 px-4 py-3 rounded-lg shadow-lg text-sm font-medium text-white"
    >
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th
              class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"
              >Template</th
            >
            <th
              class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider hidden sm:table-cell"
              >Key</th
            >
            <th
              class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider hidden md:table-cell"
              >Last updated</th
            >
            <th
              class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"
              >Active</th
            >
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          {
            templates.map((tmpl) => (
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-5 py-3">
                  <p class="text-sm font-medium text-gray-900">{tmpl.name}</p>
                  <p class="text-xs text-gray-400 mt-0.5 truncate max-w-xs">{tmpl.subject}</p>
                </td>
                <td class="px-5 py-3 hidden sm:table-cell">
                  <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded text-gray-600">
                    {tmpl.key}
                  </code>
                </td>
                <td class="px-5 py-3 text-sm text-gray-500 hidden md:table-cell">
                  {formatDate(tmpl.updated_at ?? tmpl.created_at)}
                </td>
                <td class="px-5 py-3">
                  <button
                    class={`active-toggle relative inline-flex h-5 w-9 items-center rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 ${tmpl.active ? 'bg-green-500' : 'bg-gray-300'}`}
                    data-template-id={tmpl.id}
                    data-active={tmpl.active}
                    aria-label={tmpl.active ? 'Deactivate template' : 'Activate template'}
                    title={
                      tmpl.active ? 'Active — click to deactivate' : 'Inactive — click to activate'
                    }
                  >
                    <span
                      class={`inline-block h-3.5 w-3.5 transform rounded-full bg-white shadow transition-transform ${tmpl.active ? 'translate-x-4' : 'translate-x-0.5'}`}
                    />
                  </button>
                </td>
                <td class="px-5 py-3 text-right">
                  <a
                    href={`/admin/templates/${tmpl.id}`}
                    class="text-xs text-blue-600 hover:text-blue-800 font-medium"
                  >
                    Edit →
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminBase>

<script>
  const toast = document.getElementById('toast');

  function showToast(message: string, success = true) {
    if (!toast) return;
    toast.textContent = message;
    toast.className = `fixed top-4 right-4 z-50 px-4 py-3 rounded-lg shadow-lg text-sm font-medium text-white ${
      success ? 'bg-green-700' : 'bg-red-600'
    }`;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 3000);
  }

  document.querySelectorAll<HTMLButtonElement>('.active-toggle').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.templateId;
      const currentActive = parseInt(btn.dataset.active ?? '0', 10);
      const newActive = currentActive ? 0 : 1;

      btn.disabled = true;

      try {
        const resp = await fetch(`/api/admin/templates/${id}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ active: newActive }),
        });

        if (resp.ok) {
          // Update toggle visually
          btn.dataset.active = String(newActive);
          const knob = btn.querySelector<HTMLElement>('span');
          if (!knob) return;
          if (newActive) {
            btn.classList.remove('bg-gray-300');
            btn.classList.add('bg-green-500');
            knob.classList.remove('translate-x-0.5');
            knob.classList.add('translate-x-4');
          } else {
            btn.classList.remove('bg-green-500');
            btn.classList.add('bg-gray-300');
            knob.classList.remove('translate-x-4');
            knob.classList.add('translate-x-0.5');
          }
          showToast(newActive ? 'Template activated.' : 'Template deactivated.');
        } else {
          showToast('Failed to update template.', false);
        }
      } catch {
        showToast('Network error.', false);
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
