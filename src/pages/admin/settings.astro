---
import AdminBase from '../../layouts/AdminBase.astro';
import { checkAdminToken } from '../../lib/auth/admin.js';
import { getSystemConfig, setSystemConfig, validateConfigUpdate } from '../../lib/config.js';
import { listAgeGroups, updateAgeGroup } from '../../lib/repositories/age-groups.js';
import type { SystemConfig } from '../../lib/db/schema.js';

const env = Astro.locals.runtime.env;
const token = Astro.cookies.get('egac_admin_token')?.value ?? '';
if (!checkAdminToken(token, env)) return Astro.redirect('/admin/login');

let errors: string[] = [];
let successMessage = '';
let config = await getSystemConfig(env);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'config-save');

  if (action === 'age-group-save') {
    const ageGroupId = String(form.get('age_group_id') ?? '').trim();
    const label = String(form.get('label') ?? '').trim();
    const bookingType = String(form.get('booking_type') ?? '').trim();
    const ageMin = parseInt(String(form.get('age_min_aug31') ?? '').trim(), 10);
    const ageMax = parseInt(String(form.get('age_max_aug31') ?? '').trim(), 10);
    const sessionDaysRaw = String(form.get('session_days') ?? '').trim();
    const sessionTime = String(form.get('session_time') ?? '').trim();
    const capacityRaw = String(form.get('capacity_per_session') ?? '').trim();
    const sortOrder = parseInt(String(form.get('sort_order') ?? '').trim(), 10);
    const active = form.get('active') === '1' ? 1 : 0;

    if (!ageGroupId) errors.push('age_group_id is required');
    if (!label) errors.push('label is required');
    if (bookingType !== 'taster' && bookingType !== 'waitlist') {
      errors.push('booking_type must be taster or waitlist');
    }
    if (Number.isNaN(ageMin) || Number.isNaN(ageMax) || ageMin < 0 || ageMax < ageMin) {
      errors.push('age range is invalid');
    }
    if (Number.isNaN(sortOrder) || sortOrder < 1) {
      errors.push('sort_order must be a positive number');
    }

    let sessionDays = '[]';
    try {
      const parsed = JSON.parse(sessionDaysRaw);
      if (!Array.isArray(parsed) || parsed.some((d) => typeof d !== 'string')) {
        throw new Error('Invalid session days');
      }
      sessionDays = JSON.stringify(parsed);
    } catch {
      errors.push('session_days must be a JSON array, e.g. ["Tuesday"]');
    }

    let capacity: number | null = null;
    if (capacityRaw) {
      const n = parseInt(capacityRaw, 10);
      if (Number.isNaN(n) || n < 1 || n > 20) {
        errors.push('capacity_per_session must be empty or between 1 and 20');
      } else {
        capacity = n;
      }
    }

    if (errors.length === 0) {
      await updateAgeGroup(
        ageGroupId,
        {
          label,
          booking_type: bookingType as 'taster' | 'waitlist',
          age_min_aug31: ageMin,
          age_max_aug31: ageMax,
          session_days: sessionDays,
          session_time: sessionTime || null,
          capacity_per_session: capacity,
          active,
          sort_order: sortOrder,
        },
        env
      );
      successMessage = 'Age group updated.';
    }
  } else {
    const updates: Partial<SystemConfig> = {
      weeks_ahead_booking: String(form.get('weeks_ahead_booking') ?? '').trim(),
      capacity_per_slot: String(form.get('capacity_per_slot') ?? '').trim(),
      academy_max_age: String(form.get('academy_max_age') ?? '').trim(),
      site_name: String(form.get('site_name') ?? '').trim(),
      site_url: String(form.get('site_url') ?? '').trim(),
      email_from: String(form.get('email_from') ?? '').trim(),
      venue_name: String(form.get('venue_name') ?? '').trim(),
      venue_address: String(form.get('venue_address') ?? '').trim(),
      admin_email: String(form.get('admin_email') ?? '').trim(),
      location_tuesday: String(form.get('location_tuesday') ?? '').trim(),
      location_thursday: String(form.get('location_thursday') ?? '').trim(),
      location_saturday: String(form.get('location_saturday') ?? '').trim(),
    };

    errors = validateConfigUpdate(updates);

    if (errors.length === 0) {
      config = await setSystemConfig(updates, env);
      successMessage = 'Settings saved.';
    }
  }
}

const ageGroups = await listAgeGroups(env, false);
const appEnv = env.APP_ENV ?? 'development';
---

<AdminBase title="Settings" activeNav="settings">
  <div class="space-y-5">
    <div class="flex items-center justify-between">
      <h1 class="text-4xl font-semibold text-slate-900">Settings</h1>
      <span
        class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600"
      >
        Environment: {appEnv}
      </span>
    </div>

    {
      successMessage && (
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
          {successMessage}
        </div>
      )
    }

    {
      errors.length > 0 && (
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
          <p class="mb-1 font-medium">Please fix the following:</p>
          <ul class="list-disc pl-5">
            {errors.map((e) => (
              <li>{e}</li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs uppercase tracking-wide text-slate-500">Weeks ahead</p>
        <p class="mt-1 text-2xl font-semibold text-slate-900">{config.weeks_ahead_booking}</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs uppercase tracking-wide text-slate-500">Slot capacity</p>
        <p class="mt-1 text-2xl font-semibold text-slate-900">{config.capacity_per_slot}</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs uppercase tracking-wide text-slate-500">Academy max age</p>
        <p class="mt-1 text-2xl font-semibold text-slate-900">{config.academy_max_age}</p>
      </div>
    </div>

    <form method="POST" class="space-y-4">
      <input type="hidden" name="action" value="config-save" />
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="mb-4">
          <h2 class="text-lg font-medium text-slate-900">Booking defaults</h2>
          <p class="mt-1 text-sm text-slate-500">
            Controls how many sessions are offered and how capacity is applied.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <div>
            <label for="weeks_ahead_booking" class="mb-1 block text-sm font-medium text-slate-700"
              >Weeks ahead booking</label
            >
            <input
              id="weeks_ahead_booking"
              name="weeks_ahead_booking"
              value={config.weeks_ahead_booking}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
            />
          </div>
          <div>
            <label for="capacity_per_slot" class="mb-1 block text-sm font-medium text-slate-700"
              >Capacity per slot</label
            >
            <input
              id="capacity_per_slot"
              name="capacity_per_slot"
              value={config.capacity_per_slot}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
            />
          </div>
          <div>
            <label for="academy_max_age" class="mb-1 block text-sm font-medium text-slate-700"
              >Academy max age</label
            >
            <input
              id="academy_max_age"
              name="academy_max_age"
              value={config.academy_max_age}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
            />
          </div>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="mb-4">
          <h2 class="text-lg font-medium text-slate-900">Site and venue</h2>
          <p class="mt-1 text-sm text-slate-500">
            Used in links, emails, and confirmation details.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <label for="site_name" class="mb-1 block text-sm font-medium text-slate-700"
              >Site name</label
            >
            <input
              id="site_name"
              name="site_name"
              value={config.site_name}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
            />
          </div>
          <div>
            <label for="site_url" class="mb-1 block text-sm font-medium text-slate-700"
              >Site URL</label
            >
            <input
              id="site_url"
              name="site_url"
              value={config.site_url}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
            />
          </div>
          <div>
            <label for="venue_name" class="mb-1 block text-sm font-medium text-slate-700"
              >Venue name</label
            >
            <input
              id="venue_name"
              name="venue_name"
              value={config.venue_name}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
            />
          </div>
          <div>
            <label for="venue_address" class="mb-1 block text-sm font-medium text-slate-700"
              >Venue address</label
            >
            <input
              id="venue_address"
              name="venue_address"
              value={config.venue_address}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
            />
          </div>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="mb-4">
          <h2 class="text-lg font-medium text-slate-900">Email settings</h2>
          <p class="mt-1 text-sm text-slate-500">
            Sender and admin mailbox for alerts and test messages.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <label for="email_from" class="mb-1 block text-sm font-medium text-slate-700"
              >Email from</label
            >
            <input
              id="email_from"
              name="email_from"
              value={config.email_from}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
            />
          </div>
          <div>
            <label for="admin_email" class="mb-1 block text-sm font-medium text-slate-700"
              >Admin email</label
            >
            <input
              id="admin_email"
              name="admin_email"
              value={config.admin_email}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
            />
          </div>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="mb-4">
          <h2 class="text-lg font-medium text-slate-900">Training locations</h2>
          <p class="mt-1 text-sm text-slate-500">
            Set the training location for each session day. Leave blank to use the default venue.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <div>
            <label for="location_tuesday" class="mb-1 block text-sm font-medium text-slate-700"
              >Tuesday</label
            >
            <input
              id="location_tuesday"
              name="location_tuesday"
              value={config.location_tuesday}
              placeholder={config.venue_name}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
            />
          </div>
          <div>
            <label for="location_thursday" class="mb-1 block text-sm font-medium text-slate-700"
              >Thursday</label
            >
            <input
              id="location_thursday"
              name="location_thursday"
              value={config.location_thursday}
              placeholder={config.venue_name}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
            />
          </div>
          <div>
            <label for="location_saturday" class="mb-1 block text-sm font-medium text-slate-700"
              >Saturday</label
            >
            <input
              id="location_saturday"
              name="location_saturday"
              value={config.location_saturday}
              placeholder={config.venue_name}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
            />
          </div>
        </div>
      </section>

      <div class="flex justify-end">
        <button
          type="submit"
          class="rounded-md bg-[#2d5ea5] px-5 py-2 text-sm font-medium text-white hover:bg-[#254f89]"
        >
          Save settings
        </button>
      </div>
    </form>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="mb-4">
        <h2 class="text-lg font-medium text-slate-900">Age groups</h2>
        <p class="mt-1 text-sm text-slate-500">
          Adjust age-group ranges and session settings. Changes apply site-wide immediately.
        </p>
      </div>
      <div class="space-y-3">
        {
          ageGroups.map((group) => (
            <form method="POST" class="rounded-xl border border-slate-200 p-4">
              <input type="hidden" name="action" value="age-group-save" />
              <input type="hidden" name="age_group_id" value={group.id} />
              <div class="mb-3 flex items-center justify-between">
                <h3 class="font-semibold text-slate-900">{group.code.toUpperCase()}</h3>
                <label class="inline-flex items-center gap-2 text-xs text-slate-600">
                  <input type="checkbox" name="active" value="1" checked={group.active === 1} />{' '}
                  Active
                </label>
              </div>
              <div class="grid grid-cols-1 gap-3 md:grid-cols-4">
                <div class="md:col-span-2">
                  <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">
                    Label
                  </label>
                  <input
                    name="label"
                    value={group.label}
                    class="w-full rounded-md border border-slate-300 px-2.5 py-2 text-sm"
                  />
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">
                    Booking type
                  </label>
                  <select
                    name="booking_type"
                    class="w-full rounded-md border border-slate-300 px-2.5 py-2 text-sm"
                  >
                    <option value="taster" selected={group.booking_type === 'taster'}>
                      Taster
                    </option>
                    <option value="waitlist" selected={group.booking_type === 'waitlist'}>
                      Waitlist
                    </option>
                  </select>
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">
                    Sort order
                  </label>
                  <input
                    name="sort_order"
                    value={group.sort_order}
                    class="w-full rounded-md border border-slate-300 px-2.5 py-2 text-sm"
                  />
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">
                    Age min
                  </label>
                  <input
                    name="age_min_aug31"
                    value={group.age_min_aug31}
                    class="w-full rounded-md border border-slate-300 px-2.5 py-2 text-sm"
                  />
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">
                    Age max
                  </label>
                  <input
                    name="age_max_aug31"
                    value={group.age_max_aug31}
                    class="w-full rounded-md border border-slate-300 px-2.5 py-2 text-sm"
                  />
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">
                    Session time
                  </label>
                  <input
                    name="session_time"
                    value={group.session_time ?? ''}
                    class="w-full rounded-md border border-slate-300 px-2.5 py-2 text-sm"
                  />
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">
                    Capacity/session
                  </label>
                  <input
                    name="capacity_per_session"
                    value={group.capacity_per_session ?? ''}
                    class="w-full rounded-md border border-slate-300 px-2.5 py-2 text-sm"
                  />
                </div>
                <div class="md:col-span-4">
                  <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">
                    Session days (JSON array)
                  </label>
                  <input
                    name="session_days"
                    value={group.session_days}
                    class="w-full rounded-md border border-slate-300 px-2.5 py-2 text-sm font-mono"
                  />
                </div>
              </div>
              <div class="mt-3 flex justify-end">
                <button
                  type="submit"
                  class="rounded-md border border-[#2d5ea5] px-3 py-1.5 text-xs font-medium text-[#2d5ea5] hover:bg-blue-50"
                >
                  Save age group
                </button>
              </div>
            </form>
          ))
        }
      </div>
    </section>
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-medium text-slate-900">Platform documentation</h2>
          <p class="mt-1 text-sm text-slate-500">
            Architecture, database schema, cron jobs, deployment, and developer reference.
          </p>
        </div>
        <a
          href="/docs"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-md border border-[#2d5ea5] px-4 py-2 text-sm font-medium text-[#2d5ea5] hover:bg-blue-50"
        >
          Open docs
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-3.5 w-3.5"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"
            ></path>
            <path
              d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"
            ></path>
          </svg>
        </a>
      </div>
    </section>
  </div>
</AdminBase>
