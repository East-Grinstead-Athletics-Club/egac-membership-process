---
// src/pages/admin/login.astro
// Admin login. Accepts the ADMIN_TOKEN as a password, sets a session cookie,
// and redirects to /admin/enquiries on success.

import AdminBase from '../../layouts/AdminBase.astro';
import { checkAdminToken } from '../../lib/auth/admin.js';

const env = Astro.locals.runtime.env;
let error = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const token = formData.get('token')?.toString().trim() ?? '';

  if (checkAdminToken(token, env)) {
    Astro.cookies.set('egac_admin_token', token, {
      path: '/',
      httpOnly: true,
      sameSite: 'lax',
      secure: env.APP_ENV !== 'development',
      maxAge: 8 * 60 * 60, // 8 hours
    });
    return Astro.redirect('/admin/enquiries');
  }
  error = 'Invalid token. Please try again.';
}
---

<AdminBase title="Login">
  <div class="mx-auto mt-14 max-w-sm">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
      <h1 class="mb-2 text-center text-3xl font-semibold text-slate-900">Admin Login</h1>
      <p class="mb-6 text-center text-sm text-slate-500">Enter your admin token to continue</p>

      {
        error && (
          <div class="mb-4 rounded border border-red-200 bg-red-50 p-3 text-sm text-red-700">
            {error}
          </div>
        )
      }

      <form method="POST" class="space-y-4">
        <div>
          <label for="token" class="mb-1 block text-sm font-medium text-slate-700">
            Admin Token
          </label>
          <input
            type="password"
            id="token"
            name="token"
            required
            autofocus
            class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
            placeholder="Enter your admin token"
          />
        </div>
        <button
          type="submit"
          class="w-full rounded-md bg-[#2d5ea5] px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-[#254f89]"
        >
          Sign in
        </button>
      </form>
    </div>
  </div>
</AdminBase>
