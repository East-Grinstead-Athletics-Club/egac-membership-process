---
// src/pages/admin/login.astro
// Admin login. Accepts the ADMIN_TOKEN as a password, sets a session cookie,
// and redirects to /admin/enquiries on success.

import AdminBase from '../../layouts/AdminBase.astro';
import { checkAdminToken } from '../../lib/auth/admin.js';

const env = Astro.locals.runtime.env;
let error = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const token = formData.get('token')?.toString().trim() ?? '';

  if (checkAdminToken(token, env)) {
    Astro.cookies.set('egac_admin_token', token, {
      path: '/admin',
      httpOnly: true,
      sameSite: 'lax',
      maxAge: 8 * 60 * 60, // 8 hours
    });
    return Astro.redirect('/admin/enquiries');
  }
  error = 'Invalid token. Please try again.';
}
---

<AdminBase title="Login">
  <div class="max-w-sm mx-auto mt-16">
    <div class="bg-white rounded-lg shadow-md p-8">
      <h1 class="text-xl font-bold text-gray-900 mb-6 text-center">Admin Login</h1>

      {
        error && (
          <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded text-sm text-red-700">
            {error}
          </div>
        )
      }

      <form method="POST" class="space-y-4">
        <div>
          <label for="token" class="block text-sm font-medium text-gray-700 mb-1">
            Admin Token
          </label>
          <input
            type="password"
            id="token"
            name="token"
            required
            autofocus
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
            placeholder="Enter your admin token"
          />
        </div>
        <button
          type="submit"
          class="w-full bg-blue-800 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition-colors font-medium text-sm"
        >
          Sign in
        </button>
      </form>
    </div>
  </div>
</AdminBase>
