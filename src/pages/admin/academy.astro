---
import AdminBase from '../../layouts/AdminBase.astro';
import { checkAdminToken } from '../../lib/auth/admin.js';
import {
  listAcademySeasons,
  listWaitlistBySeason,
  listUnassignedWaitlist,
  updateSeasonStatus,
  updateWaitlistStatus,
} from '../../lib/repositories/academy.js';
import { getEnquiryById } from '../../lib/repositories/enquiries.js';
import type { AcademySeason, AcademyWaitlistEntry, AcademyWaitlistStatus } from '../../lib/db/schema.js';

const env = Astro.locals.runtime.env;
const token = Astro.cookies.get('egac_admin_token')?.value ?? '';
if (!checkAdminToken(token, env)) return Astro.redirect('/admin/login');

let successMessage = '';
let errorMessage = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  try {
    if (action === 'season-status') {
      const seasonId = String(form.get('season_id') ?? '');
      const status = String(form.get('status') ?? '') as AcademySeason['status'];
      const validStatuses: AcademySeason['status'][] = ['upcoming', 'open', 'closed', 'archived'];
      if (!seasonId || !validStatuses.includes(status)) {
        throw new Error('Invalid season status update request.');
      }
      await updateSeasonStatus(seasonId, status, env);
      successMessage = 'Season status updated.';
    }

    if (action === 'waitlist-status') {
      const waitlistId = String(form.get('waitlist_id') ?? '');
      const status = String(form.get('status') ?? '') as AcademyWaitlistStatus;
      const validStatuses: AcademyWaitlistStatus[] = [
        'waiting',
        'invited',
        'accepted',
        'declined',
        'ineligible',
        'withdrawn',
      ];
      if (!waitlistId || !validStatuses.includes(status)) {
        throw new Error('Invalid waitlist status update request.');
      }
      await updateWaitlistStatus(waitlistId, status, env);
      successMessage = 'Waitlist entry updated.';
    }
  } catch (e) {
    errorMessage = e instanceof Error ? e.message : 'Update failed.';
  }
}

const seasons = await listAcademySeasons(env);
const unassigned = await listUnassignedWaitlist(env);
const waitlistBySeason = await Promise.all(
  seasons.map(async (season) => ({
    season,
    entries: await listWaitlistBySeason(season.id, env),
  }))
);

const enquiryCache = new Map<string, { name: string | null; email: string }>();
async function getEnquiryDetails(enquiryId: string): Promise<{ name: string | null; email: string }> {
  const cached = enquiryCache.get(enquiryId);
  if (cached) return cached;
  const enquiry = await getEnquiryById(enquiryId, env);
  const details = { name: enquiry?.name ?? null, email: enquiry?.email ?? '' };
  enquiryCache.set(enquiryId, details);
  return details;
}

type EnrichedWaitlist = AcademyWaitlistEntry & { enquiry_name: string | null; enquiry_email: string };

async function enrich(entries: AcademyWaitlistEntry[]): Promise<EnrichedWaitlist[]> {
  return Promise.all(
    entries.map(async (entry) => {
      const details = await getEnquiryDetails(entry.enquiry_id);
      return { ...entry, enquiry_name: details.name, enquiry_email: details.email };
    })
  );
}

const unassignedEnriched = await enrich(unassigned);
const seasonBlocks = await Promise.all(
  waitlistBySeason.map(async (block) => ({
    season: block.season,
    entries: await enrich(block.entries),
  }))
);

const totalSeasonEntries = seasonBlocks.reduce((sum, b) => sum + b.entries.length, 0);
const openSeasons = seasonBlocks.filter((b) => b.season.status === 'open').length;
const acceptedTotal = seasonBlocks.reduce(
  (sum, b) => sum + b.entries.filter((e) => e.status === 'accepted').length,
  0
);

function formatDate(iso: string | null): string {
  if (!iso) return '—';
  return new Date(iso).toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });
}

function statusBadge(status: string): string {
  switch (status) {
    case 'accepted':
      return 'bg-emerald-100 text-emerald-700';
    case 'invited':
      return 'bg-blue-100 text-blue-700';
    case 'declined':
      return 'bg-rose-100 text-rose-700';
    case 'waiting':
      return 'bg-amber-100 text-amber-700';
    case 'ineligible':
    case 'withdrawn':
      return 'bg-slate-100 text-slate-600';
    default:
      return 'bg-slate-100 text-slate-600';
  }
}
---

<AdminBase title="Academy" activeNav="academy">
  <div class="space-y-5">
    <h1 class="text-4xl font-semibold text-slate-900">Academy</h1>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs uppercase tracking-wide text-slate-500">Seasons</p>
        <p class="mt-1 text-2xl font-semibold text-slate-900">{seasonBlocks.length}</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs uppercase tracking-wide text-slate-500">Open seasons</p>
        <p class="mt-1 text-2xl font-semibold text-slate-900">{openSeasons}</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs uppercase tracking-wide text-slate-500">Unassigned waitlist</p>
        <p class="mt-1 text-2xl font-semibold text-slate-900">{unassignedEnriched.length}</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs uppercase tracking-wide text-slate-500">Accepted total</p>
        <p class="mt-1 text-2xl font-semibold text-slate-900">{acceptedTotal}</p>
      </div>
    </div>

    {
      successMessage && (
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
          {successMessage}
        </div>
      )
    }

    {
      errorMessage && (
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
          {errorMessage}
        </div>
      )
    }

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="mb-3 flex items-center justify-between gap-3">
        <h2 class="text-lg font-medium text-slate-900">Unassigned waitlist</h2>
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
          {unassignedEnriched.length} entries
        </span>
      </div>
      {
        unassignedEnriched.length === 0 ? (
          <p class="text-sm italic text-slate-400">No unassigned waitlist entries.</p>
        ) : (
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
                  <th class="py-2">Athlete</th>
                  <th class="py-2">Email</th>
                  <th class="py-2">Created</th>
                  <th class="py-2">Status</th>
                  <th class="py-2">Action</th>
                </tr>
              </thead>
              <tbody>
                {unassignedEnriched.map((entry) => (
                  <tr class="border-b border-slate-100">
                    <td class="py-2">{entry.enquiry_name || 'Unknown'}</td>
                    <td class="py-2 text-slate-600">{entry.enquiry_email || '—'}</td>
                    <td class="py-2 text-slate-600">{formatDate(entry.created_at)}</td>
                    <td class="py-2">
                      <span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-medium ${statusBadge(entry.status)}`}>
                        {entry.status}
                      </span>
                    </td>
                    <td class="py-2">
                      <form method="POST" class="flex items-center gap-2">
                        <input type="hidden" name="action" value="waitlist-status" />
                        <input type="hidden" name="waitlist_id" value={entry.id} />
                        <select name="status" class="rounded-md border border-slate-300 px-2 py-1 text-xs">
                          <option selected={entry.status === 'waiting'} value="waiting">Waiting</option>
                          <option selected={entry.status === 'invited'} value="invited">Invited</option>
                          <option selected={entry.status === 'accepted'} value="accepted">Accepted</option>
                          <option selected={entry.status === 'declined'} value="declined">Declined</option>
                          <option selected={entry.status === 'ineligible'} value="ineligible">Ineligible</option>
                          <option selected={entry.status === 'withdrawn'} value="withdrawn">Withdrawn</option>
                        </select>
                        <button class="rounded-md bg-[#2d5ea5] px-2.5 py-1 text-xs font-medium text-white hover:bg-[#254f89]" type="submit">
                          Save
                        </button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-medium text-slate-900">Season allocation</h2>
        <span class="text-xs text-slate-500">{totalSeasonEntries} linked entries</span>
      </div>

      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      {
        seasonBlocks.map((block) => {
          const acceptedCount = block.entries.filter((e) => e.status === 'accepted').length;
          const fillRate = block.season.capacity > 0 ? Math.min(100, Math.round((acceptedCount / block.season.capacity) * 100)) : 0;
          return (
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <div class="mb-3 flex items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-semibold text-slate-900">{block.season.label}</h3>
                  <p class="text-xs text-slate-500">{formatDate(block.season.start_date)} to {formatDate(block.season.end_date)}</p>
                  <p class="mt-1 text-xs text-slate-500">{acceptedCount} accepted / {block.season.capacity} capacity</p>
                </div>
                <form method="POST" class="flex items-center gap-2">
                  <input type="hidden" name="action" value="season-status" />
                  <input type="hidden" name="season_id" value={block.season.id} />
                  <select name="status" class="rounded-md border border-slate-300 px-2 py-1 text-xs">
                    <option selected={block.season.status === 'upcoming'} value="upcoming">Upcoming</option>
                    <option selected={block.season.status === 'open'} value="open">Open</option>
                    <option selected={block.season.status === 'closed'} value="closed">Closed</option>
                    <option selected={block.season.status === 'archived'} value="archived">Archived</option>
                  </select>
                  <button class="rounded-md border border-[#2d5ea5] px-2.5 py-1 text-xs font-medium text-[#2d5ea5] hover:bg-blue-50" type="submit">
                    Update
                  </button>
                </form>
              </div>

              <div class="mb-3 h-2 w-full rounded-full bg-slate-200">
                <div class="h-2 rounded-full bg-[#2d5ea5]" style={`width: ${fillRate}%`}></div>
              </div>

              {
                block.entries.length === 0 ? (
                  <p class="text-sm italic text-slate-400">No entries in this season.</p>
                ) : (
                  <div class="space-y-2">
                    {block.entries.slice(0, 8).map((entry) => (
                      <div class="flex items-center justify-between rounded-lg border border-slate-100 px-3 py-2 text-sm">
                        <div>
                          <p class="font-medium text-slate-800">{entry.enquiry_name || 'Unknown'}</p>
                          <p class="text-xs text-slate-500">{entry.enquiry_email || '—'}</p>
                        </div>
                        <span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-medium ${statusBadge(entry.status)}`}>
                          {entry.status}
                        </span>
                      </div>
                    ))}
                    {block.entries.length > 8 && (
                      <p class="text-xs text-slate-400">Showing first 8 of {block.entries.length} entries.</p>
                    )}
                  </div>
                )
              }
            </article>
          );
        })
      }
      </div>
    </section>
  </div>
</AdminBase>
