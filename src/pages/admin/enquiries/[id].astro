---
// src/pages/admin/enquiries/[id].astro
// Admin enquiry detail page. Shows full enquiry info, event timeline,
// bookings, and actions (edit note, resend invite).
// Auth: checks egac_admin_token cookie server-side.

import AdminBase from '../../../layouts/AdminBase.astro';
import { checkAdminToken } from '../../../lib/auth/admin.js';
import { getEnquiryById } from '../../../lib/repositories/enquiries.js';
import { getInviteById } from '../../../lib/repositories/invites.js';
import { listBookingsByEnquiry } from '../../../lib/repositories/bookings.js';
import type { Enquiry, Invite, Booking, EnquiryEvent } from '../../../lib/db/schema.js';

// ── Auth check ───────────────────────────────────────────────────────────────

const env = Astro.locals.runtime.env;
const token = Astro.cookies.get('egac_admin_token')?.value ?? '';
if (!checkAdminToken(token, env)) {
  return Astro.redirect('/admin/login');
}

// ── Load data ────────────────────────────────────────────────────────────────

const { id } = Astro.params;
const enquiry: Enquiry | null = id ? await getEnquiryById(id, env) : null;

let events: EnquiryEvent[] = [];
let invite: Invite | null = null;
let bookings: Booking[] = [];

if (enquiry) {
  // Parse events log (newest first)
  try {
    events = (JSON.parse(enquiry.events || '[]') as EnquiryEvent[]).sort(
      (a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()
    );
  } catch {
    events = [];
  }

  // Load invite and bookings in parallel
  [invite, bookings] = await Promise.all([
    enquiry.invite_id ? getInviteById(enquiry.invite_id, env) : Promise.resolve(null),
    listBookingsByEnquiry(enquiry.id, env),
  ]);
}

// ── Helpers ──────────────────────────────────────────────────────────────────

function formatDate(iso: string | null): string {
  if (!iso) return '—';
  const d = new Date(iso);
  return d.toLocaleDateString('en-GB', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });
}

function formatDateTime(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

function eventLabel(type: string): string {
  const map: Record<string, string> = {
    academy_waitlist_added: 'Added to academy waitlist',
    academy_response_received: 'Academy response received',
    booking_invite_sent: 'Booking invite sent',
    booking_created: 'Booking created',
    invite_expired: 'Invite expired',
    invite_resent: 'Invite resent',
    attendance_recorded: 'Attendance recorded',
    membership_invite_sent: 'Membership invite sent',
    reminder_sent: 'Reminder sent',
  };
  return map[type] ?? type;
}

const bookingUrl = invite ? `/book/${invite.token}` : null;
---

<AdminBase
  title={enquiry ? `Enquiry — ${enquiry.name || enquiry.email}` : 'Enquiry'}
  activeNav="enquiries"
>
  <div class="space-y-5">
    <a href="/admin/enquiries" class="text-sm text-[#2d5ea5] hover:underline">← Back to enquiries</a>

    {
      !enquiry ? (
        <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
          Enquiry not found.
        </div>
      ) : (
        <>
          <h1 class="text-3xl font-semibold text-slate-900">Enquiry Detail</h1>

          <div class="grid grid-cols-1 gap-4 xl:grid-cols-[2fr_1fr]">
            <div class="space-y-4">
              <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="mb-4 text-lg font-medium text-slate-900">Contact Information</h2>
                <dl class="grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
                  <div>
                    <dt class="text-xs uppercase tracking-wide text-slate-500">Full name</dt>
                    <dd class="mt-1 text-slate-900">{enquiry.name || '—'}</dd>
                  </div>
                  <div>
                    <dt class="text-xs uppercase tracking-wide text-slate-500">Email</dt>
                    <dd class="mt-1 text-slate-900">{enquiry.email}</dd>
                  </div>
                  <div>
                    <dt class="text-xs uppercase tracking-wide text-slate-500">Phone</dt>
                    <dd class="mt-1 text-slate-900">{enquiry.phone || '—'}</dd>
                  </div>
                  <div>
                    <dt class="text-xs uppercase tracking-wide text-slate-500">Date of birth</dt>
                    <dd class="mt-1 text-slate-900">{formatDate(enquiry.dob)}</dd>
                  </div>
                  <div>
                    <dt class="text-xs uppercase tracking-wide text-slate-500">Age group</dt>
                    <dd class="mt-1 text-slate-900">{enquiry.age_group_id || '—'}</dd>
                  </div>
                  <div>
                    <dt class="text-xs uppercase tracking-wide text-slate-500">Path</dt>
                    <dd class="mt-1">
                      <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${enquiry.source.toLowerCase().includes('academy') ? 'bg-violet-100 text-violet-700' : 'bg-blue-100 text-blue-700'}`}>
                        {enquiry.source.toLowerCase().includes('academy') ? 'Academy' : 'Taster'}
                      </span>
                    </dd>
                  </div>
                </dl>
              </section>

              <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="mb-3 text-lg font-medium text-slate-900">Bookings</h2>
                {bookings.length === 0 ? (
                  <p class="text-sm italic text-slate-400">No bookings.</p>
                ) : (
                  <table class="min-w-full text-sm">
                    <thead>
                      <tr class="text-left text-xs uppercase tracking-wide text-slate-500">
                        <th class="pb-2">Date</th>
                        <th class="pb-2">Slot</th>
                        <th class="pb-2">Status</th>
                        <th class="pb-2">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      {bookings.map((b) => (
                        <tr class="border-t border-slate-100">
                          <td class="py-2">{formatDate(b.session_date)}</td>
                          <td class="py-2">{b.age_group_id} ({b.session_time || '—'})</td>
                          <td class="py-2">
                            <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${b.status === 'confirmed' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-600'}`}>{b.status}</span>
                          </td>
                          <td class="py-2">
                            <a href="/admin/bookings" class="text-[#2d5ea5] hover:underline">Manage</a>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
              </section>

              <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="mb-2 text-lg font-medium text-slate-900">Notes</h2>
                <textarea
                  id="note-input"
                  rows="3"
                  class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-[#2d5ea5] focus:ring-2 focus:ring-blue-100"
                  placeholder="Add a note about this enquiry..."
                >{enquiry.note || ''}</textarea>
                <button
                  id="save-note-btn"
                  class="mt-3 rounded-md border border-[#2d5ea5] px-4 py-2 text-sm font-medium text-[#2d5ea5] hover:bg-blue-50"
                >Save note</button>
                <span id="note-status" class="ml-3 text-sm text-gray-500 hidden" />
                {enquiry.note && <p id="note-display" class="hidden">{enquiry.note}</p>}
              </section>
            </div>

            <aside class="space-y-4">
              <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="mb-4 text-lg font-medium text-slate-900">Timeline</h2>
                {events.length === 0 ? (
                  <p class="text-sm text-slate-400">No events recorded.</p>
                ) : (
                  <ol class="space-y-3">
                    {events.map((ev) => (
                      <li class="grid grid-cols-[92px_1fr] gap-2 text-xs">
                        <span class="text-slate-400">{formatDateTime(ev.timestamp)}</span>
                        <span class="text-slate-700">{eventLabel(ev.type as string)}</span>
                      </li>
                    ))}
                  </ol>
                )}
              </section>

              <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="mb-3 text-lg font-medium text-slate-900">Actions</h2>
                <button
                  id="resend-invite-btn"
                  class="w-full rounded-md border border-[#2d5ea5] px-4 py-2 text-sm font-medium text-[#2d5ea5] hover:bg-blue-50"
                >Resend invite</button>
                {bookingUrl && (
                  <a href={bookingUrl} target="_blank" rel="noopener" class="mt-2 block text-center text-xs text-[#2d5ea5] hover:underline">Open booking page</a>
                )}
                <span id="resend-status" class="mt-2 block text-sm text-gray-500 hidden" />
              </section>
            </aside>
          </div>
        </>
      )
    }
  </div>
</AdminBase>

<script define:vars={{ enquiryId: id }}>
  // ── Save note ──────────────────────────────────────────────

  const saveBtn = document.getElementById('save-note-btn');
  const noteInput = document.getElementById('note-input');
  const noteStatus = document.getElementById('note-status');

  if (saveBtn && noteInput && noteStatus && enquiryId) {
    saveBtn.addEventListener('click', async () => {
      const note = noteInput.value.trim() || null;
      saveBtn.disabled = true;
      noteStatus.textContent = 'Saving…';
      noteStatus.classList.remove('hidden', 'text-red-600');
      noteStatus.classList.add('text-gray-500');

      try {
        const resp = await fetch(`/api/admin/enquiries/${enquiryId}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ note }),
        });
        if (resp.ok) {
          noteStatus.textContent = 'Saved.';
        } else {
          noteStatus.textContent = 'Save failed.';
          noteStatus.classList.add('text-red-600');
        }
      } catch {
        noteStatus.textContent = 'Network error.';
        noteStatus.classList.add('text-red-600');
      } finally {
        saveBtn.disabled = false;
        noteStatus.classList.remove('hidden');
        setTimeout(() => noteStatus.classList.add('hidden'), 3000);
      }
    });
  }

  // ── Resend invite ──────────────────────────────────────────

  const resendBtn = document.getElementById('resend-invite-btn');
  const resendStatus = document.getElementById('resend-status');

  if (resendBtn && resendStatus && enquiryId) {
    resendBtn.addEventListener('click', async () => {
      resendBtn.disabled = true;
      resendStatus.textContent = 'Sending…';
      resendStatus.classList.remove('hidden', 'text-red-600');
      resendStatus.classList.add('text-gray-500');

      try {
        const resp = await fetch('/api/admin/invites/resend', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ enquiry_id: enquiryId }),
        });
        const data = await resp.json();
        if (resp.ok) {
          resendStatus.textContent = data.data?.reused
            ? 'Invite resent (reused existing).'
            : 'New invite sent.';
          setTimeout(() => location.reload(), 1500);
        } else {
          resendStatus.textContent = data.error ?? 'Send failed.';
          resendStatus.classList.add('text-red-600');
          resendBtn.disabled = false;
        }
      } catch {
        resendStatus.textContent = 'Network error.';
        resendStatus.classList.add('text-red-600');
        resendBtn.disabled = false;
      } finally {
        resendStatus.classList.remove('hidden');
      }
    });
  }
</script>
