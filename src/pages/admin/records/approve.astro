---
// src/pages/admin/records/approve.astro
// Admin approval dashboard for pending records
// Auth: Requires valid egac_admin_token cookie

import { D1Database } from '@cloudflare/workers-types';
import { checkAdminToken } from '../../../lib/auth/admin';

const env = Astro.locals.runtime.env;
const token = Astro.cookies.get('egac_admin_token')?.value ?? '';

// Auth check
if (!checkAdminToken(token, env)) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;
const adminId = 'admin';

// ============================================================================
// FORM HANDLERS
// ============================================================================

let message = { type: '', text: '' };

// Handle approval
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action')?.toString();
  const achievementId = formData.get('achievement_id')?.toString();

  try {
    if (!achievementId) throw new Error('Achievement ID is required');

    const achievement = await db
      .prepare('SELECT * FROM achievements WHERE id = ?')
      .bind(achievementId)
      .first<Record<string, unknown>>();

    if (!achievement) throw new Error('Achievement not found');

    if (action === 'approve') {
      // Check if this is a new record (better than current)
      const currentBest = await db
        .prepare(
          `
          SELECT ach.id, ach.result_raw, e.sort_order
          FROM achievements ach
          JOIN event_definitions e ON ach.event_id = e.id
          WHERE 
            ach.event_id = ?
            AND ach.category_id = ?
            AND ach.gender = ?
            AND ach.status = 'approved'
            AND ach.is_current_record = TRUE
          LIMIT 1
        `
        )
        .bind(achievement.event_id, achievement.category_id, achievement.gender)
        .first<{ id: string; result_raw: number; sort_order: string }>();

      let isNewRecord = false;
      let previousRecordId = null;

      if (currentBest) {
        const sortOrder = await db
          .prepare('SELECT sort_order FROM event_definitions WHERE id = ?')
          .bind(achievement.event_id)
          .first<{ sort_order: string }>();

        const isBetter =
          sortOrder?.sort_order === 'ASC'
            ? achievement.result_raw < currentBest.result_raw
            : achievement.result_raw > currentBest.result_raw;

        if (isBetter) {
          isNewRecord = true;
          previousRecordId = currentBest.id;

          // Mark previous record as not current
          await db
            .prepare('UPDATE achievements SET is_current_record = FALSE WHERE id = ?')
            .bind(currentBest.id)
            .run();
        }
      } else {
        // No current record for this combo, this is the first
        isNewRecord = true;
      }

      // Approve the achievement
      const now = new Date().toISOString();
      await db
        .prepare(
          `
          UPDATE achievements
          SET 
            status = 'approved',
            approved_by = ?,
            approved_at = ?,
            is_current_record = ?,
            previous_record_id = ?,
            updated_at = ?
          WHERE id = ?
        `
        )
        .bind(adminId, now, isNewRecord, previousRecordId, now, achievementId)
        .run();

      // Update record_holders table
      await updateRecordHolder(
        db,
        achievement.event_id,
        achievement.category_id,
        achievement.gender
      );

      message = {
        type: 'success',
        text: `Record approved${isNewRecord ? ' - NEW CLUB RECORD! 🏆' : ''}`,
      };
    } else if (action === 'reject') {
      const rejectionReason = formData.get('rejection_reason')?.toString();

      const now = new Date().toISOString();
      await db
        .prepare(
          `
          UPDATE achievements
          SET 
            status = 'rejected',
            rejection_reason = ?,
            updated_at = ?
          WHERE id = ?
        `
        )
        .bind(rejectionReason || null, now, achievementId)
        .run();

      message = { type: 'success', text: 'Record rejected' };
    }
  } catch (error) {
    message = {
      type: 'error',
      text: error instanceof Error ? error.message : 'Unknown error',
    };
  }
}

// ============================================================================
// HELPER FUNCTION
// ============================================================================

async function updateRecordHolder(
  db: D1Database,
  eventId: string,
  categoryId: string,
  gender: string | null
) {
  // Get the current best approved record for this combo
  const currentEvent = await db
    .prepare('SELECT sort_order FROM event_definitions WHERE id = ?')
    .bind(eventId)
    .first<{ sort_order: string }>();

  const best = await db
    .prepare(
      `
      SELECT 
        id, 
        athlete_id,
        COALESCE(a.name, athlete_name_raw) as athlete_name,
        COALESCE(a.EA_reg_number, ea_number_raw) as ea_number,
        result_raw,
        achieved_at
      FROM achievements ach
      LEFT JOIN athletes a ON ach.athlete_id = a.id
      WHERE 
        ach.event_id = ?
        AND ach.category_id = ?
        AND ach.gender = ?
        AND ach.status = 'approved'
      ORDER BY ach.result_raw ${currentEvent?.sort_order === 'ASC' ? 'ASC' : 'DESC'}
      LIMIT 1
    `
    )
    .bind(eventId, categoryId, gender || null)
    .first<{
      id: string;
      athlete_id: string | null;
      athlete_name: string;
      ea_number: string | null;
      result_raw: number;
      achieved_at: string;
    }>();

  if (!best) return;

  // Update or insert into record_holders
  const recordHolderId = crypto.randomUUID();
  await db
    .prepare(
      `
      INSERT OR REPLACE INTO record_holders 
      (id, event_id, category_id, gender, athlete_id, athlete_name, ea_number, result_raw, achieved_at, achievement_id, updated_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `
    )
    .bind(
      recordHolderId,
      eventId,
      categoryId,
      gender,
      best.athlete_id,
      best.athlete_name,
      best.ea_number,
      best.result_raw,
      best.achieved_at,
      best.id,
      new Date().toISOString()
    )
    .run();
}

// ============================================================================
// FETCH PENDING RECORDS
// ============================================================================

const pending = await db
  .prepare(
    `
    SELECT 
      ach.id,
      ach.athlete_name_raw,
      ach.ea_number_raw,
      ach.gender,
      ach.result_raw,
      ach.achieved_at,
      ach.notes,
      ach.created_at,
      ach.created_by,
      e.name as event_name,
      e.unit_type,
      e.sort_order,
      c.name as category_name
    FROM achievements ach
    JOIN event_definitions e ON ach.event_id = e.id
    JOIN categories c ON ach.category_id = c.id
    WHERE ach.status = 'pending'
    ORDER BY ach.created_at DESC
  `
  )
  .all<Record<string, unknown>>();

// Import utility to format results
const { formatFromRaw } = await import('../../../lib/records-util');
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Approve Records</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        background: #f5f5f5;
        padding: 1rem;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
      }

      h1 {
        color: #333;
        margin-bottom: 1rem;
      }

      .breadcrumb {
        font-size: 0.875rem;
        color: #666;
        margin-bottom: 1.5rem;
      }

      .breadcrumb a {
        color: #0066cc;
        text-decoration: none;
      }

      .message {
        padding: 1rem;
        border-radius: 4px;
        margin-bottom: 1.5rem;
        border-left: 4px solid;
      }

      .message.success {
        background: #e8f5e9;
        border-color: #66bb6a;
        color: #2e7d32;
      }

      .message.error {
        background: #fde8e8;
        border-color: #ef5350;
        color: #c62828;
      }

      .records-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
        gap: 1.5rem;
      }

      .record-card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        padding: 1.5rem;
        transition: box-shadow 0.2s;
      }

      .record-card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
      }

      .record-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 1rem;
        border-bottom: 2px solid #eee;
        padding-bottom: 0.75rem;
      }

      .event-info h3 {
        font-size: 1.25rem;
        color: #0066cc;
        margin-bottom: 0.25rem;
      }

      .category-badge {
        display: inline-block;
        background: #e3f2fd;
        color: #1565c0;
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.85rem;
        font-weight: 600;
      }

      .gender-badge {
        display: inline-block;
        background: #f3e5f5;
        color: #6a1b9a;
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.85rem;
        margin-left: 0.5rem;
      }

      .record-body {
        margin-bottom: 1rem;
      }

      .record-field {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        font-size: 0.95rem;
      }

      .record-field label {
        color: #666;
        font-weight: 500;
      }

      .record-field value {
        color: #333;
        font-weight: 600;
      }

      .result-highlight {
        font-size: 1.25rem;
        background: #fff3e0;
        color: #e65100;
        padding: 0.75rem;
        border-radius: 4px;
        text-align: center;
        margin: 1rem 0;
      }

      .record-notes {
        background: #f5f5f5;
        padding: 0.75rem;
        border-radius: 4px;
        font-size: 0.9rem;
        color: #666;
        margin: 0.75rem 0;
      }

      .metadata {
        font-size: 0.85rem;
        color: #999;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #eee;
      }

      .actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        margin-top: 1.5rem;
      }

      button {
        padding: 0.75rem 1rem;
        border: none;
        border-radius: 4px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.95rem;
      }

      .btn-approve {
        background: #4caf50;
        color: white;
      }

      .btn-approve:hover {
        background: #45a049;
      }

      .btn-reject {
        background: #f44336;
        color: white;
      }

      .btn-reject:hover {
        background: #da190b;
      }

      .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
      }

      .modal.show {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .modal-content {
        background: white;
        padding: 2rem;
        border-radius: 8px;
        max-width: 400px;
      }

      .modal-content h3 {
        margin-bottom: 1rem;
        color: #333;
      }

      textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-family: inherit;
        font-size: 0.95rem;
        resize: vertical;
        min-height: 100px;
      }

      .modal-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        margin-top: 1rem;
      }

      .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #999;
      }

      .empty-state svg {
        width: 80px;
        height: 80px;
        margin-bottom: 1rem;
        opacity: 0.5;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="breadcrumb">
        <a href="/admin">Admin</a> / <a href="/admin/records">Records</a> / Approve
      </div>

      <h1>🔍 Pending Records Review</h1>

      {message.text && <div class={`message ${message.type}`}>{message.text}</div>}

      {
        pending.results.length === 0 ? (
          <div class="empty-state">
            <svg fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
              <path
                fill-rule="evenodd"
                d="M4 5a2 2 0 012-2 1 1 0 000 2H6a1 1 0 100-2h-.5A2.5 2.5 0 013 7.5V17a2 2 0 002 2h10a2 2 0 002-2v-9.5A2.5 2.5 0 0013.5 5H13a1 1 0 100 2h.5A1 1 0 0015 5v9.5a1 1 0 01-1 1H5a1 1 0 01-1-1V5z"
                clip-rule="evenodd"
              />
            </svg>
            <p>No pending records to review</p>
            <p style="font-size: 0.9rem; margin-top: 0.5rem;">
              Check back later or <a href="/admin/records/add">add a new record</a>
            </p>
          </div>
        ) : (
          <div class="records-grid">
            {pending.results.map((record) => (
              <div class="record-card" data-id={record.id}>
                <div class="record-header">
                  <div class="event-info">
                    <h3>{record.event_name}</h3>
                    <div>
                      <span class="category-badge">{record.category_name}</span>
                      {record.gender && <span class="gender-badge">{record.gender}</span>}
                    </div>
                  </div>
                </div>

                <div class="record-body">
                  <div class="result-highlight">
                    {formatFromRaw(record.result_raw, record.unit_type)}
                  </div>

                  <div class="record-field">
                    <label>Athlete:</label>
                    <span class="value">{record.athlete_name_raw}</span>
                  </div>

                  {record.ea_number_raw && (
                    <div class="record-field">
                      <label>EA Number:</label>
                      <span class="value">{record.ea_number_raw}</span>
                    </div>
                  )}

                  <div class="record-field">
                    <label>Date:</label>
                    <span class="value">{new Date(record.achieved_at).toLocaleDateString()}</span>
                  </div>

                  {record.notes && <div class="record-notes">{record.notes}</div>}

                  <div class="metadata">
                    <div>Submitted: {new Date(record.created_at).toLocaleString()}</div>
                    <div>By: {record.created_by}</div>
                  </div>
                </div>

                <div class="actions">
                  <button class="btn-approve" onclick={`approveRecord('${record.id}')`}>
                    ✅ Approve
                  </button>
                  <button class="btn-reject" onclick={`openRejectModal('${record.id}')`}>
                    ❌ Reject
                  </button>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>

    <!-- Reject Confirmation Modal -->
    <div id="rejectModal" class="modal">
      <div class="modal-content">
        <h3>Reject Record</h3>
        <p>Please provide a reason for rejection:</p>
        <textarea
          id="rejectionReason"
          placeholder="e.g., 'No verification provided', 'Incorrect event category', 'Athlete not found'"
        ></textarea>
        <div class="modal-actions">
          <button onclick="submitReject()" class="btn-reject">Reject</button>
          <button onclick="closeRejectModal()" style="background: #ccc; color: #333;">
            Cancel
          </button>
        </div>
      </div>
    </div>

    <script>
      let currentRejectId = null;

      function approveRecord(id) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.innerHTML = `
          <input type="hidden" name="action" value="approve">
          <input type="hidden" name="achievement_id" value="${id}">
        `;
        document.body.appendChild(form);
        form.submit();
      }

      function openRejectModal(id) {
        currentRejectId = id;
        document.getElementById('rejectModal').classList.add('show');
      }

      function closeRejectModal() {
        document.getElementById('rejectModal').classList.remove('show');
        currentRejectId = null;
      }

      function submitReject() {
        if (!currentRejectId) return;

        const reason = document.getElementById('rejectionReason').value;
        const form = document.createElement('form');
        form.method = 'POST';
        form.innerHTML = `
          <input type="hidden" name="action" value="reject">
          <input type="hidden" name="achievement_id" value="${currentRejectId}">
          <input type="hidden" name="rejection_reason" value="${reason.replace(/"/g, '&quot;')}">
        `;
        document.body.appendChild(form);
        form.submit();
      }

      // Close modal on outside click
      document.getElementById('rejectModal').addEventListener('click', function (e) {
        if (e.target === this) {
          closeRejectModal();
        }
      });
    </script>
  </body>
</html>
