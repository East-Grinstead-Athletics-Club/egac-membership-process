---
// src/pages/index.astro
// Public enquiry form — the main entry point for new athletes.
// Submits to POST /api/enquiry via fetch (JS) with plain form POST fallback.

import Base from '../layouts/Base.astro';
---

<Base
  title="Join EGAC"
  description="Register your child's interest in East Grinstead Athletics Club taster sessions or the U11 Academy programme."
>
  <div id="form-section">
    <h1 class="text-2xl font-bold text-blue-900 mb-1">Get in touch</h1>
    <p class="text-gray-600 mb-8">
      Register your interest and we'll be in touch with next steps — either a taster session booking
      link or information about our Academy programme.
    </p>

    <!-- Error summary (shown on validation failure) -->
    <div
      id="error-summary"
      class="hidden bg-red-50 border border-red-300 rounded-lg p-4 mb-6"
      role="alert"
      aria-live="assertive"
    >
      <p class="font-semibold text-red-800 mb-1">Please fix the following:</p>
      <ul id="error-list" class="list-disc list-inside text-red-700 text-sm space-y-1"></ul>
    </div>

    <form id="enquiry-form" method="POST" action="/api/enquiry" novalidate class="space-y-5">
      <fieldset>
        <legend class="block text-sm font-medium text-gray-700 mb-2">Who is this enquiry for?</legend>
        <div class="grid gap-2 sm:grid-cols-2">
          <label class="flex items-start gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm">
            <input
              type="radio"
              name="enquiry_for"
              value="self"
              checked
              class="mt-0.5 accent-blue-700"
            />
            <span>I'm enquiring for myself</span>
          </label>
          <label class="flex items-start gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm">
            <input
              type="radio"
              name="enquiry_for"
              value="other"
              class="mt-0.5 accent-blue-700"
            />
            <span>I'm enquiring on behalf of someone else</span>
          </label>
        </div>
      </fieldset>

      <!-- Full name -->
      <div>
        <label id="name-label" for="name" class="block text-sm font-medium text-gray-700 mb-1">
          Full name <span class="text-red-500" aria-hidden="true">*</span>
        </label>
        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          aria-describedby="name-error"
          class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 focus:outline-none"
          placeholder="Parent or guardian name"
        />
        <p id="name-error" class="hidden mt-1 text-xs text-red-600" role="alert"></p>
      </div>

      <!-- Email -->
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
          Email address <span class="text-red-500" aria-hidden="true">*</span>
        </label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          aria-describedby="email-error"
          class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 focus:outline-none"
          placeholder="you@example.com"
        />
        <p id="email-error" class="hidden mt-1 text-xs text-red-600" role="alert"></p>
      </div>

      <!-- Phone -->
      <div>
        <label id="phone-label" for="phone" class="block text-sm font-medium text-gray-700 mb-1">
          Phone number
          <span class="text-gray-400 font-normal">(optional)</span>
        </label>
        <input
          id="phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 focus:outline-none"
          placeholder="07700 900000"
        />
      </div>

      <div id="athlete-name-wrap" class="hidden">
        <label id="athlete-name-label" for="athlete_name" class="block text-sm font-medium text-gray-700 mb-1">
          Athletes name <span class="text-red-500" aria-hidden="true">*</span>
        </label>
        <input
          id="athlete_name"
          name="athlete_name"
          type="text"
          aria-describedby="athlete_name-error"
          class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 focus:outline-none"
          placeholder="Name of the person you are enquiring about"
        />
        <p id="athlete_name-error" class="hidden mt-1 text-xs text-red-600" role="alert"></p>
      </div>

      <!-- Date of birth -->
      <div>
        <label id="dob-label" for="dob" class="block text-sm font-medium text-gray-700 mb-1">
          Date of birth <span class="text-red-500" aria-hidden="true">*</span>
        </label>
        <input
          id="dob"
          name="dob"
          type="date"
          autocomplete="bday"
          aria-describedby="dob-error"
          class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 focus:outline-none"
        />
        <p id="dob-error" class="hidden mt-1 text-xs text-red-600" role="alert"></p>
      </div>

      <div class="pt-2">
        <button
          id="submit-btn"
          type="submit"
          class="w-full rounded-lg bg-blue-800 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-60 disabled:cursor-not-allowed transition-colors"
        >
          Send enquiry
        </button>
      </div>
    </form>
  </div>

  <!-- Confirmation (shown after successful submission) -->
  <div id="confirmation" class="hidden text-center py-8">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-green-100 mb-4">
      <svg
        class="w-7 h-7 text-green-600"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"
        ></path>
      </svg>
    </div>
    <h2 class="text-xl font-bold text-gray-900 mb-2">Enquiry received</h2>
    <p id="confirmation-message" class="text-gray-600 max-w-sm mx-auto"></p>
    <p class="mt-4 text-sm text-gray-400">
      Can't find our email? Check your spam folder or contact us at
      <a href="mailto:info@eastgrinsteadac.org.uk" class="text-blue-700 underline">
        info@eastgrinsteadac.org.uk
      </a>.
    </p>
  </div>
</Base>

<script>
  const form = document.getElementById('enquiry-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formSection = document.getElementById('form-section') as HTMLElement;
  const confirmation = document.getElementById('confirmation') as HTMLElement;
  const confirmationMessage = document.getElementById('confirmation-message') as HTMLElement;
  const errorSummary = document.getElementById('error-summary') as HTMLElement;
  const errorList = document.getElementById('error-list') as HTMLElement;
  const athleteNameWrap = document.getElementById('athlete-name-wrap') as HTMLElement;
  const nameLabel = document.getElementById('name-label') as HTMLElement;
  const phoneLabel = document.getElementById('phone-label') as HTMLElement;
  const dobLabel = document.getElementById('dob-label') as HTMLElement;
  const athleteNameLabel = document.getElementById('athlete-name-label') as HTMLElement;
  const athleteNameInput = document.getElementById('athlete_name') as HTMLInputElement;
  const enquiryForInputs = document.querySelectorAll<HTMLInputElement>('input[name="enquiry_for"]');

  function selectedEnquiryFor(): 'self' | 'other' {
    const selected = document.querySelector<HTMLInputElement>('input[name="enquiry_for"]:checked');
    return selected?.value === 'other' ? 'other' : 'self';
  }

  function syncEnquiryMode() {
    const mode = selectedEnquiryFor();
    const onBehalf = mode === 'other';

    athleteNameWrap.classList.toggle('hidden', !onBehalf);
    athleteNameInput.required = onBehalf;
    if (!onBehalf) athleteNameInput.value = '';

    nameLabel.innerHTML = `${onBehalf ? 'Your full name' : 'Your full name'} <span class="text-red-500" aria-hidden="true">*</span>`;
    phoneLabel.innerHTML = `Your contact number <span class="text-gray-400 font-normal">(optional)</span>`;
    athleteNameLabel.innerHTML = `Athletes name <span class="text-red-500" aria-hidden="true">*</span>`;
    dobLabel.innerHTML = `${onBehalf ? 'Athletes date of birth' : 'Your date of birth'} <span class="text-red-500" aria-hidden="true">*</span>`;
  }

  enquiryForInputs.forEach((input) => input.addEventListener('change', syncEnquiryMode));
  syncEnquiryMode();

  function clearErrors() {
    errorSummary.classList.add('hidden');
    errorList.innerHTML = '';
    document.querySelectorAll('[id$="-error"]').forEach((el) => {
      el.classList.add('hidden');
      el.textContent = '';
    });
    document.querySelectorAll('input, select, textarea').forEach((el) => {
      el.classList.remove('border-red-500');
    });
  }

  function showFieldError(fieldId: string, message: string) {
    const field = document.getElementById(fieldId) as HTMLInputElement;
    const errorEl = document.getElementById(`${fieldId}-error`);
    if (field) field.classList.add('border-red-500');
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
  }

  function showSummaryErrors(messages: string[]) {
    errorSummary.classList.remove('hidden');
    errorList.innerHTML = messages.map((m) => `<li>${m}</li>`).join('');
    errorSummary.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    const firstField = document.querySelector('input.border-red-500') as HTMLElement;
    if (firstField) firstField.focus();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const data = new FormData(form);
    const enquiryFor = selectedEnquiryFor();
    const name = (data.get('name') as string).trim();
    const email = (data.get('email') as string).trim();
    const phone = (data.get('phone') as string).trim();
    const athleteName = ((data.get('athlete_name') as string) || '').trim();
    const dob = (data.get('dob') as string).trim();

    // Client-side validation
    const errors: string[] = [];
    if (!name) {
      showFieldError('name', 'Full name is required');
      errors.push('Full name is required');
    }
    if (!email) {
      showFieldError('email', 'Email address is required');
      errors.push('Email address is required');
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showFieldError('email', 'Please enter a valid email address');
      errors.push('Please enter a valid email address');
    }
    if (enquiryFor === 'other' && !athleteName) {
      showFieldError('athlete_name', 'Athletes name is required');
      errors.push('Athletes name is required');
    }
    if (!dob) {
      showFieldError('dob', 'Date of birth is required');
      errors.push('Date of birth is required');
    }

    if (errors.length > 0) {
      showSummaryErrors(errors);
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    try {
      const response = await fetch('/api/enquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          enquiry_for: enquiryFor,
          enquirer_name: name,
          enquirer_email: email,
          enquirer_phone: phone || undefined,
          athlete_name: enquiryFor === 'other' ? athleteName : name,
          athlete_dob: dob || undefined,
          // Legacy keys retained for compatibility while API transition settles.
          name,
          email,
          phone: phone || undefined,
          dob: dob || undefined,
        }),
      });

      const json = (await response.json()) as { message?: string; code?: string };

      if (response.ok || response.status === 409) {
        // 409 = duplicate — treat as success so we don't reveal registration status
        const isWaitlist =
          json.message?.toLowerCase().includes('waitlist') ||
          json.message?.toLowerCase().includes('academy');
        confirmationMessage.textContent = isWaitlist
          ? "We've added your child to the Academy waitlist. We'll be in touch before the season starts."
          : 'Thanks — check your email for a link to book your first session. It should arrive within a few minutes.';
        formSection.classList.add('hidden');
        confirmation.classList.remove('hidden');
      } else if (response.status === 422) {
        // Validation error from server
        const message = json.message ?? 'Please check your details and try again.';
        showFieldError('email', message);
        showSummaryErrors([message]);
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send enquiry';
      } else {
        showSummaryErrors(['Something went wrong. Please try again or contact us directly.']);
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send enquiry';
      }
    } catch {
      showSummaryErrors(['Unable to send — please check your connection and try again.']);
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send enquiry';
    }
  });
</script>
