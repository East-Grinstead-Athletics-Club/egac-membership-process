---
// src/pages/index.astro
// Public enquiry form. POSTs to /api/enquiry server-side.
// Works without JS (progressive enhancement).

import Layout from '../layouts/Layout.astro';

type ResultType = 'taster' | 'waitlist' | 'duplicate' | null;
let result: { type: ResultType; error?: string } = { type: null };

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();

    const body = {
      parent_name:   formData.get('parent_name')?.toString().trim()   ?? '',
      child_name:    formData.get('child_name')?.toString().trim()    ?? '',
      email:         formData.get('email')?.toString().trim()         ?? '',
      phone:         formData.get('phone')?.toString().trim()         || null,
      date_of_birth: formData.get('date_of_birth')?.toString().trim() || null,
    };

    const response = await fetch(new URL('/api/enquiry', Astro.url), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });

    const data = await response.json() as { routing?: string; error?: string };

    if (response.status === 409) {
      result = { type: 'duplicate' };
    } else if (response.ok) {
      result = { type: (data.routing as 'taster' | 'waitlist') ?? 'taster' };
    } else {
      result = { type: null, error: data.error ?? 'Something went wrong. Please try again.' };
    }
  } catch {
    result = { type: null, error: 'Could not submit your enquiry. Please try again.' };
  }
}

const showForm = result.type === null;
---

<Layout title="Join EGAC" description="Enquire about taster sessions or the U11 Academy at East Grinstead Athletics Club.">

  {/* ── Taster success ── */}
  {result.type === 'taster' && (
    <div class="card" style="margin-top:2rem">
      <div class="confirm-icon confirm-icon-success">
        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <p class="page-eyebrow">Enquiry received</p>
      <h1 class="page-title" style="font-size:1.9rem">You're on the list!</h1>
      <p class="page-subtitle">
        Thanks for getting in touch. We'll review your enquiry and send you a booking link for a
        taster session within the next few days. Keep an eye on your inbox — including your junk folder.
      </p>
      <div class="alert alert-info">
        <strong>What happens next?</strong><br/>
        You'll receive a personalised link to choose a Tuesday evening session. Places are limited
        to 2 per age group each week, so please book promptly when you receive it.
      </div>
    </div>
  )}

  {/* ── Academy waitlist success ── */}
  {result.type === 'waitlist' && (
    <div class="card" style="margin-top:2rem">
      <div class="confirm-icon confirm-icon-success">
        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <p class="page-eyebrow">Academy enquiry received</p>
      <h1 class="page-title" style="font-size:1.9rem">Added to the Academy waitlist</h1>
      <p class="page-subtitle">
        We've added your child to the U11 Academy waitlist for the next programme (April–August).
        We'll be in touch when places become available.
      </p>
      <div class="alert alert-warning">
        <strong>U11 Academy places are limited to 40 per season.</strong><br/>
        Returning athletes are prioritised, then the waitlist in order of enquiry. No action is
        needed from you — we'll email when we're ready to offer places.
      </div>
    </div>
  )}

  {/* ── Duplicate ── */}
  {result.type === 'duplicate' && (
    <div class="card" style="margin-top:2rem">
      <div class="confirm-icon confirm-icon-info">
        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <p class="page-eyebrow">Already registered</p>
      <h1 class="page-title" style="font-size:1.9rem">We've already got your details</h1>
      <p class="page-subtitle">
        That email address has already been used to submit an enquiry. If you haven't heard from us,
        please check your junk folder or contact us directly.
      </p>
    </div>
  )}

  {/* ── Server error ── */}
  {result.error && (
    <div class="alert alert-error" style="margin-bottom:1.5rem">{result.error}</div>
  )}

  {/* ── Enquiry form ── */}
  {showForm && (
    <>
      <p class="page-eyebrow">East Grinstead Athletics Club</p>
      <h1 class="page-title">Get involved</h1>
      <p class="page-subtitle">
        Fill in the form below and we'll get back to you with the right next step — a taster session
        invite or, for younger athletes, information about our Academy programme.
      </p>

      <div class="card">
        <form method="POST" novalidate>

          <p style="font-size:0.78rem;font-weight:700;letter-spacing:0.09em;text-transform:uppercase;color:var(--muted);margin-bottom:0.875rem">
            Parent / Guardian
          </p>

          <div class="form-group">
            <label class="form-label" for="parent_name">Your name</label>
            <input class="form-input" type="text" id="parent_name" name="parent_name"
              autocomplete="name" required placeholder="e.g. Sarah Ahmed" />
          </div>

          <div class="form-group">
            <label class="form-label" for="email">Email address</label>
            <input class="form-input" type="email" id="email" name="email"
              autocomplete="email" required placeholder="you@example.com" />
            <p class="form-hint">We'll send your booking link to this address.</p>
          </div>

          <div class="form-group" style="margin-bottom:1.5rem;padding-bottom:1.5rem;border-bottom:1px solid var(--border)">
            <label class="form-label" for="phone">
              Phone number <span class="optional">(optional)</span>
            </label>
            <input class="form-input" type="tel" id="phone" name="phone"
              autocomplete="tel" placeholder="07700 900000" />
          </div>

          <p style="font-size:0.78rem;font-weight:700;letter-spacing:0.09em;text-transform:uppercase;color:var(--muted);margin-bottom:0.875rem">
            Young Athlete
          </p>

          <div class="form-group">
            <label class="form-label" for="child_name">Athlete's name</label>
            <input class="form-input" type="text" id="child_name" name="child_name"
              autocomplete="off" required placeholder="e.g. Zara Ahmed" />
          </div>

          <div class="form-group" style="margin-bottom:1.5rem;padding-bottom:1.5rem;border-bottom:1px solid var(--border)">
            <label class="form-label" for="date_of_birth">
              Date of birth <span class="optional">(recommended)</span>
            </label>
            <input class="form-input" type="date" id="date_of_birth" name="date_of_birth"
              autocomplete="bday" max={new Date().toISOString().split('T')[0]} />
            <p class="form-hint">
              Helps us place your child in the right age group. UK Athletics uses age on 31 August.
            </p>
          </div>

          <p style="font-size:0.8rem;color:var(--muted);margin-bottom:1.25rem;line-height:1.55">
            By submitting this form you agree that EGAC may contact you about training and events.
            We won't share your details with third parties.
          </p>

          <button type="submit" class="btn btn-primary btn-block" style="font-size:1.1rem;padding:1rem">
            Send enquiry &rarr;
          </button>
        </form>
      </div>

      <div class="card" style="margin-top:1.25rem;background:var(--navy-light);border-color:transparent;box-shadow:none">
        <p style="font-size:0.78rem;font-weight:700;letter-spacing:0.09em;text-transform:uppercase;color:var(--muted);margin-bottom:0.875rem">
          Age groups &amp; sessions
        </p>
        <div style="display:grid;gap:0.7rem">
          {[
            { code: 'U11 Academy', detail: 'Ages 9–10 on 31 Aug · Sat mornings + Tue evenings · April–August · Waitlist only' },
            { code: 'U13',         detail: 'Ages 11–12 on 31 Aug · Tuesday evenings, 18:30 · Taster session to start' },
            { code: 'U15',         detail: 'Ages 13–14 on 31 Aug · Tuesday evenings, 18:30 · Taster session to start' },
            { code: 'U17',         detail: 'Ages 15–16 on 31 Aug · Tuesday evenings, 19:30 · Taster session to start' },
            { code: 'U20',         detail: 'Ages 17–19 on 31 Aug · Tuesday evenings, 19:30 · Taster session to start' },
          ].map(g => (
            <div style="display:flex;gap:0.75rem;align-items:baseline">
              <span style="font-family:var(--font-display);font-weight:700;font-size:0.9rem;color:var(--navy);min-width:90px">{g.code}</span>
              <span style="font-size:0.82rem;color:var(--muted);line-height:1.4">{g.detail}</span>
            </div>
          ))}
        </div>
      </div>
    </>
  )}

</Layout>

<script>
  // Progressive enhancement: client-side validation + submit loading state
  const form = document.querySelector<HTMLFormElement>('form');
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener('submit', (e) => {
    const required = ['parent_name', 'child_name', 'email'] as const;
    let valid = true;

    required.forEach(name => {
      const input = form.elements.namedItem(name) as HTMLInputElement | null;
      if (input && !input.value.trim()) {
        input.style.borderColor = 'var(--red)';
        valid = false;
      }
    });

    const email = form.elements.namedItem('email') as HTMLInputElement | null;
    if (email?.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
      email.style.borderColor = 'var(--red)';
      valid = false;
    }

    if (!valid) { e.preventDefault(); return; }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
    }
  });

  document.querySelectorAll<HTMLInputElement>('.form-input').forEach(input => {
    input.addEventListener('input', () => { input.style.borderColor = ''; });
  });
</script>
