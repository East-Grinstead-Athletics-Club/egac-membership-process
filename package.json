{
  "name": "egac",
  "version": "0.1.0",
  "private": true,
  "description": "East Grinstead Athletics Club — Astro + Cloudflare Pages platform",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts,.astro --max-warnings 0 --no-eslintrc -c .eslintrc.cjs",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "type-check": "tsc --noEmit",
    "migrate:local": "wrangler d1 execute egac --local --file=db/migrations/0001_initial_schema.sql",
    "migrate:seed": "wrangler d1 execute egac --local --file=db/seed.sql",
    "migrate:staging": "wrangler d1 execute egac-staging --env staging --file=db/migrations/0001_initial_schema.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^10.0.0",
    "astro": "^4.0.0",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240821.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^8.57.1",
    "eslint-config-recommended": "^4.1.0",
    "eslint-plugin-astro": "^1.2.0",
    "miniflare": "^3.20240821.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.67.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
